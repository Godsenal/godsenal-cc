#!/usr/bin/env python3
"""gbase-run — run one gbase orchestrator slot headless with `claude -p` and write result.json.

A thin wrapper over plugins/base/references/orchestrator.md: it resolves the slot's invoke from
factory.json, sets the AGENT_* variables, runs claude, and parses the column-0 report lines.
Skill behavior lives in the skills, not here.

  gbase-run --repo <path> --slot <slot> [--task "..." | --task-file <path>] [--worktree <name>]
            [--base <ref>] [--model opus|sonnet] [--ship-owner orchestrator|agent] [--answers <file>] [--exclusive]
  gbase-run --dir <folder> --slot task|content [--task "..." | --task-file <path>] [--model opus|sonnet] [--answers <file>]
  gbase-run start <the same arguments>   # detached: prints the run id and result.json path, then returns
  gbase-run status <run-id>     # result.json; "status": "running" while the run is going
  gbase-run stop <run-id> [--reason "..."]  # SIGTERM the runner, which ends each claude's process group
  gbase-run list                # one JSON line per run, newest first
  gbase-run cite <run-id>       # the run's provenance line (model, account, run id, skills)
  gbase-run land <run-id> [--onto <branch>]  # fast-forward or cherry-pick a local-only run's commits onto a branch
  gbase-run gc [--older-than 3d] [--dry-run] # remove finished runs' worktrees whose work landed or was never made

The last stdout line of a run is the absolute path of its result.json (`start` prints it after the run id); a run that reported `교훈:` lines
prints a `next:` line before it.

Env: GBASE_CLAUDE (claude binary), GBASE_HOME (default ~/.gbase; runs/ and worktrees/ live there),
GBASE_PLUGIN_DIR (default: plugins/base of this checkout; factory.json is read from it), GBASE_PLUGIN_DIRS
(os.pathsep-separated plugin dirs loaded besides it and the plugin a slot's invoke names, from plugins/*),
GBASE_PERMISSION_MODE (default bypassPermissions), GBASE_ASK_CMD (AGENT_ASK_CMD for the child; default
records questions only), GBASE_ACCOUNTS (`name:config-dir,...`, else $GBASE_HOME/accounts with one `name:config-dir`
per line: the accounts tried in order on a usage limit or a failed login), GBASE_PREFLIGHT_TTL (seconds an account
check is cached, default 300).
"""
import argparse
import fcntl
import hashlib
import json
import os
import re
import secrets
import shlex
import signal
import subprocess
import sys
import threading
import time
from datetime import datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PLUGIN_DIR = Path(os.environ.get("GBASE_PLUGIN_DIR") or ROOT / "plugins" / "base").resolve()
# loaded with gbase besides the plugin a slot's invoke names (content → gshorts); the other plugins stay out
# of dev runs, where their skills (gapp's deploy, store-submit) could trigger on their own
EXTRA_PLUGIN_DIRS = [Path(d).expanduser().resolve() for d in os.environ.get("GBASE_PLUGIN_DIRS", "").split(os.pathsep) if d]
PLUGIN_DIRS = [PLUGIN_DIR]  # set per run by plugin_dirs()
STOPPING = threading.Event()
# headless runs have no next turn to wake into: a wakeup only adds a turn after the report (headless.md)
DISALLOWED_TOOLS = "ScheduleWakeup,CronCreate"
STOP_GRACE = 10  # seconds between SIGTERM and SIGKILL for a claude process group
HOME = Path(os.environ.get("GBASE_HOME") or "~/.gbase").expanduser().resolve()
RUNS = HOME / "runs"
SEVERITY = ["critical", "high", "medium", "low"]
PROCS = []  # running claude children, terminated when the runner is stopped

# report lines at column 0 of the final message (orchestrator.md#report-lines)
DECISION = re.compile(r"^결정 필요: .*$", re.M)
SHIP = re.compile(r"^ship: .*$", re.M)
PR_BODY = re.compile(r"^PR 본문 초안: (.+)$", re.M)
SETTLE = re.compile(r"^settle: .*$", re.M)
PR_URL = re.compile(r"^pr: <?(https?://[^\s<>`]+)", re.M)  # go/branch-pr's `pr: <url>` line
MOCKUP = re.compile(r"^mockup( url| shots)?: (.+)$", re.M)
LESSON = re.compile(r"^교훈: .*$", re.M)  # content-common's feedback intake: a lesson for a work run to ship
POLL = 5  # seconds between checks while --exclusive waits for another run on the same repo
SHIPPING_SLOTS = {"work", "ship"}  # slots that end in go: a PR (agent owner) or a `ship:` line (orchestrator)
DIR_SLOTS = {"task", "content"}  # slots that may run in a plain folder (--dir): nothing in them needs git
# one more turn for a session that stopped before shipping its change (run 20261029-091345-work-53d226 ended on
# go's review table: change uncommitted, no PR)
RESUME_PROMPT = ("The run ended before the change shipped: the worktree has work in it and the report has no `{line}` "
                 "line. Finish it with gbase:go from the step you stopped at, without redoing a review or polish that "
                 "already ran. If you stopped on purpose (nothing to ship, or a step only a person can take), say why "
                 "in one line, with a `결정 필요:` line for the person's step, and end.")


def claude_bin():
    if os.environ.get("GBASE_CLAUDE"):
        return os.environ["GBASE_CLAUDE"]
    local = Path("~/.claude/local/claude").expanduser()
    return str(local) if local.exists() else "claude"


# a session that ends on one of these before any tool call did no work, so another account can take the prompt
# (runs 20261102-231947-work-d5bdaa and -235119-work-ea5cd1 ended in ~50 ms on "Not logged in · Please run /login")
AUTH_FAIL = re.compile(r"Not logged in|Please run /login|Invalid API key|OAuth token (?:has )?expired|authentication_error", re.I)
# not a bare "limit reached": a rate or output-token limit is no reason to drop an account
LIMIT_FAIL = re.compile(r"hit your [^\n]*limit|usage limit|usage_limit_reached", re.I)
PREFLIGHT_TTL = int(os.environ.get("GBASE_PREFLIGHT_TTL") or 300)
DEFAULT_CONFIG_DIR = Path("~/.claude").expanduser()


def load_accounts():
    """[(name, config dir)] from GBASE_ACCOUNTS or $GBASE_HOME/accounts, or None when neither is set: the run then
    uses claude's own environment as the one account `default`, unchecked."""
    raw = os.environ.get("GBASE_ACCOUNTS")
    if raw is None and (HOME / "accounts").is_file():
        raw = (HOME / "accounts").read_text(encoding="utf-8")
    entries = [e.strip() for e in re.split(r"[,\n]", raw or "") if e.strip() and not e.strip().startswith("#")]
    accounts = []
    for entry in entries:
        name, _, path = entry.partition(":")
        accounts.append((name.strip(), path.strip() or None))
    return accounts or None


def account_env(env, path):
    """env for an account's config dir; None leaves it as the runner got it."""
    if path is None:
        return env
    env = dict(env)
    if Path(path).expanduser().resolve() == DEFAULT_CONFIG_DIR.resolve():
        # claude's default dir runs with the variable unset: claude keys its stored login by the variable, so
        # CLAUDE_CONFIG_DIR=~/.claude can read as logged out where plain `claude` is logged in (추정, from the
        # 2026-11-02 runs that failed only through the runner)
        env.pop("CLAUDE_CONFIG_DIR", None)
    else:
        env["CLAUDE_CONFIG_DIR"] = str(Path(path).expanduser())
    return env


def fail_kind(text):
    return "auth" if AUTH_FAIL.search(text) else "usage_limit" if LIMIT_FAIL.search(text) else None


def fail_detail(text):
    line = next((ln for ln in text.splitlines() if AUTH_FAIL.search(ln) or LIMIT_FAIL.search(ln)), text.strip())
    return line.strip()[:300]


def prestart_failure(info):
    """(kind, detail) when a session ended on a login or usage-limit error before any tool call, else None."""
    if info.get("tool_uses") or not (info.get("is_error") or info.get("exit_code")):
        return None
    text = "\n".join(info.get("results", []) + info.get("errors", []))
    kind = fail_kind(text)
    return (kind, fail_detail(text)) if kind else None


def account_cache(update=None):
    path = HOME / "accounts.json"
    try:
        cache = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        cache = {}
    if update:
        cache.update(update)
        HOME.mkdir(parents=True, exist_ok=True)
        write_json(path, cache)
    return cache


def preflight(name, path, env):
    """(kind, detail) when the account can't run (`claude -p ok --max-turns 1` answers with a login or limit
    error), else None — also when the check itself fails some other way, so a flaky check never blocks a run.
    Cached PREFLIGHT_TTL seconds in $GBASE_HOME/accounts.json, failures from real sessions included."""
    hit = account_cache().get(name)
    if hit and time.time() - hit.get("checked_at", 0) < PREFLIGHT_TTL:
        return None if hit.get("ok") else (hit.get("kind"), hit.get("detail"))
    try:
        # no MCP servers to start; not --bare, which skips the keychain read this check is for
        r = subprocess.run([claude_bin(), "-p", "ok", "--max-turns", "1", "--output-format", "json",
                            "--strict-mcp-config"], cwd=HOME,
                           env=account_env(env, path), capture_output=True, text=True, stdin=subprocess.DEVNULL,
                           timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return None
    try:
        out = json.loads(r.stdout)
        text, failed = str(out.get("result") or ""), bool(out.get("is_error")) or r.returncode != 0
    except (json.JSONDecodeError, AttributeError):
        text, failed = r.stdout, r.returncode != 0
    text += "\n" + r.stderr
    kind = failed and fail_kind(text)
    detail = fail_detail(text) if kind else None
    account_cache({name: {"ok": not kind, "kind": kind or None, "detail": detail, "checked_at": time.time()}})
    return (kind, detail) if kind else None


def auth_failed_on(task, days=1):
    """Accounts that auth-failed on a run of this task in the last `days`: tried last, not first, next time."""
    if not task:
        return set()
    cutoff, out = time.time() - days * 86400, set()
    for path in sorted(RUNS.glob("*/result.json"), reverse=True)[:300]:
        try:
            if time.mktime(time.strptime(path.parent.name[:15], "%Y%m%d-%H%M%S")) < cutoff:
                break
            r = json.loads(path.read_text(encoding="utf-8"))
        except (ValueError, OSError, json.JSONDecodeError):
            continue
        if r.get("task") == task:
            out |= {f.get("account") for f in r.get("failures") or [] if f.get("kind") == "auth"}
    return out


class Accounts:
    """The accounts a run may use, in order; `current()` is the first that passes its preflight (configured
    accounts only), `fail()` drops one a session found logged out or limited. Shared by a models slot's threads."""

    def __init__(self, env, task, prefer=None):
        configured = load_accounts()
        self.checked = configured is not None
        burned = auth_failed_on(task)
        # stable: the answered run's account first, then the configured order; one that just auth-failed on this
        # task goes last (run ea5cd1 retried the account d5bdaa had failed on, and failed the same way)
        self.queue = sorted(configured or [("default", None)], key=lambda a: (a[0] in burned, a[0] != prefer))
        self.env, self.failures, self.lock = env, [], threading.Lock()

    def current(self):
        with self.lock:
            while self.queue:
                name, path = self.queue[0]
                bad = self.checked and preflight(name, path, self.env)
                if not bad:
                    return self.queue[0]
                self.failures.append({"kind": bad[0], "account": name, "detail": bad[1], "stage": "preflight"})
                self.queue.pop(0)
            return None

    def fail(self, account, kind, detail):
        with self.lock:
            self.failures.append({"kind": kind, "account": account[0], "detail": detail, "stage": "run"})
            if self.checked:
                account_cache({account[0]: {"ok": False, "kind": kind, "detail": detail, "checked_at": time.time()}})
            if account in self.queue:
                self.queue.remove(account)


def now():
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def write_json(path, data):
    tmp = path.with_name(f".{path.name}.{os.getpid()}.{threading.get_ident()}.tmp")  # two writers never share one
    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    tmp.replace(path)  # atomic, so a poller never reads half a file


def read_jsonl(path):
    if not path.exists():
        return []
    out = []
    for line in path.read_text(encoding="utf-8").splitlines():
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return out


def git(cwd, *args):
    r = subprocess.run(["git", "-C", str(cwd), *args], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


def build_prompt(slot, spec, task, answers):
    invoke = spec["invoke"]
    if invoke is None:
        # a file slot (checks, behavior): the manifest's notes say what filling it means
        prompt = (f"Fill the `{slot}` slot of {PLUGIN_DIR / '.claude-plugin/factory.json'} for this repo: {spec['notes']} "
                  f"Append one `{slot}` line per command to $AGENT_EVIDENCE_FILE in the format of "
                  f"{PLUGIN_DIR / 'references/orchestrator.md'} (Evidence file). Don't change files. Report in Korean.")
        if task:
            prompt += f"\n\n{task}"
    elif task and re.search(r"<[^>]+>", invoke):
        prompt = re.sub(r"<[^>]+>", lambda _: task, invoke, count=1)
    else:
        prompt = f"{invoke} {task}".strip() if task else invoke
    if answers and answers.get("answers"):
        src = f"이전 실행 {answers['run_id']}에서" if answers.get("run_id") else "이전 실행에서"
        # a pasted `결정 필요:` line carries its own `→ applied (추천: …)` tail; only its question goes in the prompt
        lines = "\n".join(f"- {parse_decision(d)['question'] if DECISION_PREFIX.match(d) else d} → {a['answer']}"
                          for a in answers["answers"] for d in [str(a.get("decision") or "")])
        prompt += (f"\n\n{src} 사람이 답한 결정이다. 같은 결정이 다시 나오면 묻지 말고 이 답을 적용하고, "
                   f"그 결정에는 `결정 필요:` 줄을 쓰지 않는다.\n{lines}")
    return prompt


DECISION_KEYS = {"추천": "recommend", "다른 선택지": "options", "사람이 할 일": "human"}
DECISION_PREFIX = re.compile(r"\s*결정\s*필요\s*[:：]\s*")
DECISION_KEY = rf"(?:{'|'.join(DECISION_KEYS)})\s*[:：]"
DECISION_PARTS = re.compile(rf"\s*[;；]\s*(?={DECISION_KEY})")
# a question that points elsewhere ("위 2건을 확인해 주세요", run 20261102-121409-work-3e7261) can't be asked from the line
DEIXIS = re.compile(r"(?:위|아래|앞|상기|이것|이거|그것|그거)(?:의)?(?:\s|$)"
                    r"|(?:이|그|저)\s*(?:PR|브랜치|변경|작업)?\s*의?\s*\d+\s*(?:건|개|가지)")


def opening_paren(s):
    """Index of the `(` that closes at the end of s, nested parentheses allowed; -1 when unbalanced."""
    depth = 0
    for i in range(len(s) - 1, -1, -1):
        depth += (s[i] == ")") - (s[i] == "(")
        if depth == 0:
            return i
    return -1


def parse_decision(line):
    """`결정 필요: <q> → <applied> (추천: <r>; 다른 선택지: <a> / <b>) · AGENT_ASK_CMD 에 넘김` (headless.md) →
    {text, question, applied, recommend, options, human, incomplete}; parts a line lacks are null (options: []).
    incomplete: no 추천 and a question that only points at the report ("위 2건…"), so the caller needs final.md."""
    d = {"text": line, "question": None, "applied": None, "recommend": None, "options": [], "human": None}
    rest = DECISION_PREFIX.sub("", line, count=1).strip()
    rest = re.sub(r"\s+·\s+AGENT_ASK_CMD\s*에\s*넘김$", "", rest)
    start = opening_paren(rest) if rest.endswith(")") else -1
    if start >= 0 and re.match(rf"\s*{DECISION_KEY}", rest[start + 1:-1]):
        for part in DECISION_PARTS.split(rest[start + 1:-1].strip()):
            key, value = re.split(r"\s*[:：]\s*", part, maxsplit=1)
            field = DECISION_KEYS[key.strip()]
            d[field] = [o.strip() for o in value.split(" / ") if o.strip()] if field == "options" else value.strip()
        rest = rest[:start].rstrip()
    question, arrow, applied = rest.rpartition(" → ")
    d["question"], d["applied"] = (question.strip(), applied.strip()) if arrow else (rest, None)
    d["incomplete"] = not d["recommend"] and bool(DEIXIS.match(d["question"]))
    return d


def report(text):
    """Report lines of a run; text is every result message of the session, so the last line of each kind wins."""
    pr = PR_BODY.findall(text)
    return {
        "decisions": [parse_decision(line) for line in DECISION.findall(text)],
        "ship": (SHIP.findall(text) or [None])[-1],
        "pr_body_line": pr[-1].strip() if pr else None,
        "settle": (SETTLE.findall(text) or [None])[-1],
        "pr_url": (PR_URL.findall(text) or [""])[-1].rstrip(".,;)") or None,
        "mockup": mockup(text),
        "lessons": LESSON.findall(text),
    }


def mockup(text):
    """gbase:mockup's `mockup:` / `mockup url:` / `mockup shots:` lines → {html, url, screenshots}; url null for `none — …`."""
    lines = {kind.strip(): value.strip() for kind, value in MOCKUP.findall(text)}
    if not lines:
        return None
    url = lines.get("url")
    return {"html": lines.get(""), "url": url if url and url.startswith("http") else None,
            "screenshots": lines.get("shots")}


def review_rows(text):
    """Rows of gbase:review's table `# | severity | file:line | finding | action`."""
    rows = []
    for line in text.splitlines():
        cells = [c.strip().replace("\\|", "|") for c in re.split(r"(?<!\\)\|", line.strip().strip("|"))]
        if len(cells) < 5 or cells[1].strip("*").lower() not in SEVERITY:
            continue
        rows.append({"severity": cells[1].strip("*").lower(), "location": cells[2].strip("` "),
                     "finding": cells[3], "action": cells[4]})
    return rows


def same_place(a, b):
    """Same file, lines at most 3 apart — two reviewers rarely cite the identical line."""
    ma, mb = re.match(r"(.+?):(\d+)", a), re.match(r"(.+?):(\d+)", b)
    if ma and mb:
        return ma.group(1) == mb.group(1) and abs(int(ma.group(2)) - int(mb.group(2))) <= 3
    return a == b


def merge_reviews(by_model):
    """{model: final text} → findings with found_by, most severe first."""
    merged = []
    for model, text in by_model.items():
        for row in review_rows(text):
            hit = next((m for m in merged if model not in m["found_by"] and same_place(m["location"], row["location"])), None)
            if hit:
                hit["found_by"].append(model)
                hit["severity"] = min(hit["severity"], row["severity"], key=SEVERITY.index)
            else:
                merged.append({**row, "found_by": [model]})
    merged.sort(key=lambda m: (SEVERITY.index(m["severity"]), -len(m["found_by"])))
    return merged


def review_md(findings, models):
    out = ["| # | severity | file:line | finding | found_by |", "|---|---|---|---|---|"]
    for i, f in enumerate(findings, 1):
        who = "both" if len(f["found_by"]) == len(models) > 1 else "/".join(f["found_by"])
        out.append(f"| {i} | {f['severity']} | `{f['location']}` | {f['finding']} | {who} |")
    both = sum(len(f["found_by"]) == len(models) for f in findings)
    per = ", ".join(f"{m}만 {sum(f['found_by'] == [m] for f in findings)}" for m in models)
    out.append(f"\nreview2: {len(findings)}건 — 둘 다 {both}, {per}")
    return "\n".join(out) + "\n"


def run_claude(prompt, cwd, env, model, log_path, resume=None, append=False):
    cmd = [claude_bin(), "-p", prompt, "--output-format", "stream-json", "--verbose",
           *(("--resume", resume) if resume else ()),
           *(arg for d in PLUGIN_DIRS for arg in ("--plugin-dir", str(d))),
           "--disallowedTools", DISALLOWED_TOOLS,
           "--permission-mode", os.environ.get("GBASE_PERMISSION_MODE", "bypassPermissions")]
    if model:
        cmd += ["--model", model]
    info = {"log_path": str(log_path), "results": [], "session_id": None, "model": model, "cost_usd": None,
            "tool_uses": 0, "is_error": False, "errors": [], "skills": []}
    with open(log_path, "a" if resume or append else "w", encoding="utf-8") as log:
        # its own process group, so stopping the run also ends the subagents and shells claude started
        proc = subprocess.Popen(cmd, cwd=cwd, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, text=True, encoding="utf-8", errors="replace",
                                start_new_session=True)
        PROCS.append(proc)
        if STOPPING.is_set():  # a stop that arrived before this session started
            killpg(proc, signal.SIGTERM)
        for line in proc.stdout:
            log.write(line)
            log.flush()
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                if line.strip() and len(info["errors"]) < 20:  # claude's plain-text errors ("Not logged in")
                    info["errors"].append(line.strip())
                continue
            if not isinstance(event, dict):
                continue
            if event.get("type") == "assistant":
                for block in (event.get("message") or {}).get("content") or []:
                    if isinstance(block, dict) and block.get("type") == "tool_use":
                        info["tool_uses"] += 1
                        skill = (block.get("input") or {}).get("skill")
                        if block.get("name") == "Skill" and skill and not event.get("parent_tool_use_id"):
                            info["skills"].append(skill)
            elif event.get("type") == "system" and event.get("subtype") == "init":
                info["session_id"], info["model"] = event.get("session_id"), event.get("model")
            elif event.get("type") == "result":
                # a session can end more than one turn (a background task finishing re-invokes it);
                # keep them all, or a report line from an earlier turn is lost
                info["results"].append(event.get("result") or "")
                info["cost_usd"] = event.get("total_cost_usd")
                info["is_error"] = info["is_error"] or bool(event.get("is_error"))
                info["errors"] += [str(event[k]) for k in ("api_error", "error") if event.get(k)]
        info["exit_code"] = proc.wait()
    return info


def final_text(results):
    """The result that carries the run's report lines; the last one when none does."""
    marked = [t for t in results if SHIP.search(t) or SETTLE.search(t) or PR_BODY.search(t) or PR_URL.search(t)
              or MOCKUP.search(t) or LESSON.search(t) or review_rows(t)]
    return (marked or results or [""])[-1]


def fetch_origin(repo):
    if git(repo, "remote", "get-url", "origin") is None:
        return
    try:  # a daemon has no one to type a password: fail fast instead of hanging before result.json exists
        r = subprocess.run(["git", "-C", str(repo), "fetch", "--quiet", "origin"], capture_output=True, text=True,
                           stdin=subprocess.DEVNULL, timeout=120, env={**os.environ, "GIT_TERMINAL_PROMPT": "0"})
        err = r.stderr.strip() if r.returncode else None
    except subprocess.TimeoutExpired:
        err = "timed out"
    if err:
        print(f"gbase-run: git fetch origin failed, using the last fetched refs: {err}", file=sys.stderr)


def resolve_base(repo, ref):
    """--base, else origin's default branch, else — with no origin — the main checkout's current branch, the one
    a local-only repo's other jobs use (run 20261102-112319-work-d07cb6's commit never reached feat/feedback,
    and result.json, with base null, didn't say so); None on a detached HEAD."""
    if ref:
        if git(repo, "rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}") is None:
            sys.exit(f"gbase-run: --base {ref} is not a commit in {repo}")
        return ref
    if git(repo, "remote", "get-url", "origin") is None:
        return git(repo, "symbolic-ref", "--quiet", "--short", "HEAD") or None
    head = git(repo, "symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD")
    for cand in [head, "origin/main", "origin/master"]:
        if cand and git(repo, "rev-parse", "--verify", "--quiet", f"{cand}^{{commit}}") is not None:
            return cand
    return None


def base_counts(cwd, ref):
    """{ref, ahead, behind} of cwd's HEAD against ref, so a caller can check the commits it is about to push."""
    if not ref:
        return None
    ahead, behind = git(cwd, "rev-list", "--count", f"{ref}..HEAD"), git(cwd, "rev-list", "--count", f"HEAD..{ref}")
    return {"ref": ref, "ahead": int(ahead) if ahead else None, "behind": int(behind) if behind else None}


def main_checkout(repo):
    """The main worktree of repo, so a run given a linked worktree's path (a settle in a gbase worktree) records
    the same repo as the run that made it."""
    common = git(repo, "rev-parse", "--path-format=absolute", "--git-common-dir")
    return Path(common).parent if common and Path(common).name == ".git" else repo


def repo_key(repo):
    """origin's URL as host/path (scheme, user, `.git` dropped), else the main checkout's path: two clones of one
    repo (a user's checkout and the runner's) get the same key, where their paths differ."""
    url = git(repo, "remote", "get-url", "origin")
    if not url:
        return str(main_checkout(repo))
    url = re.sub(r"^[a-z+]+://", "", url.strip())
    url = re.sub(r"^[^@/]+@", "", url)
    if re.match(r"[^/]+:(?!\d+/)", url):  # scp-like git@host:owner/repo
        url = url.replace(":", "/", 1)
    return re.sub(r"(\.git)?/*$", "", url).lower()


def ensure_worktree(repo, name, base):
    branch = f"gbase/{name}"
    # reuse the linked worktree that already has this branch; the main checkout is never one
    listed = checked_out_at(repo, branch, linked_only=True)
    if listed and not listed.exists():
        git(repo, "worktree", "prune")  # its directory was deleted; free the branch for a new one
        listed = None
    pr = landed_pr(repo, branch)
    if pr:  # kept under another name, never deleted: a closed PR's commits may still be wanted
        if listed and git(repo, "worktree", "move", str(listed), f"{listed}-pr{pr}") is None:
            sys.exit(f"gbase-run: {branch}'s PR #{pr} has ended, and its worktree {listed} couldn't be moved aside")
        git(repo, "branch", "-m", branch, f"{branch}-pr{pr}")
        listed = None
    if listed:
        return listed, False
    # the path hash keeps two repos with the same basename from sharing a worktree; repo is the main checkout,
    # so a run given one of its linked worktrees lands in the same place
    path = worktree_path(repo, name)
    created = not path.exists()
    if created:
        exists = git(repo, "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}") is not None
        if not exists:
            fetch_origin(repo)
        # a new branch starts at base, not at whatever the main checkout has checked out (its unpushed
        # commits would ride along into the PR); without an origin, HEAD is all there is. --no-track:
        # an upstream of origin/main would make a bare `git push` and @{upstream} diffs target main
        args = (["worktree", "add", str(path), branch] if exists
                else ["worktree", "add", "--no-track", "-b", branch, str(path), base or "HEAD"])
        r = subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True)
        if r.returncode != 0:
            sys.exit(f"gbase-run: git worktree add failed: {r.stderr.strip()}")
    return path, created and not exists


def worktree_path(repo, name):
    return HOME / "worktrees" / f"{repo.name}-{hashlib.sha1(str(repo).encode()).hexdigest()[:6]}-{name}"


def remove_worktree(repo, path, branch=None):
    """Remove a linked worktree (and the branch, when given); True when it went."""
    if git(repo, "worktree", "remove", "--force", str(path)) is None:
        return False
    if branch:
        git(repo, "branch", "-D", branch)
    return True


def plugin_dirs(slot, invoke):
    """gbase, GBASE_PLUGIN_DIRS, and the plugin of a /<plugin>:<skill> invoke — failing when no dir has that
    skill, since claude would otherwise run the slash command as plain text."""
    dirs = [PLUGIN_DIR] + [d for d in EXTRA_PLUGIN_DIRS if d != PLUGIN_DIR]
    m = re.match(r"/([a-z0-9-]+):([a-z0-9-]+)", invoke or "")
    if not m:
        return dirs
    for d in dirs + sorted((ROOT / "plugins").glob("*")):
        try:
            name = json.loads((d / ".claude-plugin/plugin.json").read_text(encoding="utf-8")).get("name")
        except (OSError, json.JSONDecodeError):
            continue
        if name == m.group(1) and ((d / "skills" / m.group(2) / "SKILL.md").is_file() or (d / "commands" / f"{m.group(2)}.md").is_file()):
            return dirs if d.resolve() in dirs else dirs + [d.resolve()]
    sys.exit(f"gbase-run: slot {slot} invokes /{m.group(1)}:{m.group(2)}, which no plugin dir has "
             f"({', '.join(map(str, dirs))} or {ROOT / 'plugins'}/*); set GBASE_PLUGIN_DIRS")


def running_on(key, run_id):
    """Other runs going on the repo with this key, oldest first; --exclusive runs still in line don't count."""
    out = []
    for path in sorted(RUNS.glob("*/result.json")):
        other = path.parent.name
        if other == run_id:
            continue
        r = load_result(other)
        if (r and r.get("status") == "running" and not r.get("waiting") and r.get("repo")
                and repo_key(Path(r["repo"])) == key):
            out.append(other)
    return out


def gh(cwd, *args):
    """gh's stdout, or None when it fails or isn't installed."""
    env = {k: v for k, v in os.environ.items() if k != "GITHUB_TOKEN"}  # a stale token breaks gh here
    try:
        r = subprocess.run(["gh", *args], cwd=cwd, env=env, capture_output=True, text=True, stdin=subprocess.DEVNULL,
                           timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.stdout.strip() if r.returncode == 0 else None


def pr_url_of(cwd):
    """The open PR of cwd's branch, for a settle or agent-owned work/ship run whose report has no `pr:` line; a
    merged or closed one is an earlier change's, not this run's."""
    url = gh(cwd, "pr", "view", "--json", "url,state", "-q", 'select(.state == "OPEN") | .url')
    return url if url and url.startswith("http") else None


def head_pr(repo, branch, fields="number,state"):
    """The newest PR (any state) whose head is branch, or None."""
    out = gh(repo, "pr", "list", "--head", branch, "--state", "all", "--limit", "1", "--json", fields)
    try:
        return (json.loads(out) or [None])[0] if out else None
    except json.JSONDecodeError:
        return None


def landed_pr(repo, branch):
    """The number of the merged or closed PR whose head is branch's tip: its work is done, so a run reusing the
    name would put a squash-merged change into a second PR. None when the branch is new, open, or unpushed."""
    tip = git(repo, "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}")
    pr = tip and head_pr(repo, branch, "number,state,headRefOid")
    if not pr or pr.get("state") not in ("MERGED", "CLOSED") or not pr.get("headRefOid"):
        return None
    # the PR head may have moved on GitHub (update branch, a suggestion) past the local tip
    same = pr["headRefOid"] == tip or git(repo, "merge-base", "--is-ancestor", tip, pr["headRefOid"]) is not None
    return pr["number"] if same else None


def unshipped(slot, owner, texts, cwd, base):
    """The report line (`pr:` for an agent owner, `ship:` for orchestrator) a shipping run that ended with work in
    its worktree (uncommitted changes or unpushed commits) is missing, else None."""
    pattern, line = (SHIP, "ship:") if owner == "orchestrator" else (PR_URL, "pr:")
    if slot not in SHIPPING_SLOTS or pattern.search("\n".join(texts)):
        return None
    if git(cwd, "status", "--porcelain"):
        return line
    # commits no remote has: ones already in an open PR (the shared lessons branch) aren't unshipped work; with
    # no remote at all, the commits not on the base branch
    remote = git(cwd, "remote")
    unpushed = base and (git(cwd, "rev-list", "--count", "HEAD", "--not", "--remotes") if remote
                         else git(cwd, "rev-list", "--count", f"{base}..HEAD"))
    return line if unpushed not in (None, "", "0") else None


def write_lessons(run_id, run_dir, lessons):
    """lessons.md, the task of the work run that ships a run's `교훈:` lines, and the command for it."""
    path = run_dir / "lessons.md"
    path.write_text(f"Apply the lessons that content run {run_id} reported to the gshorts skills they name, following "
                    "content-common's feedback intake: a dated rule with the user's words in quotes, a contradicted rule "
                    "rewritten rather than duplicated, and the gshorts version bumped. Lessons runs share one "
                    "branch until its PR ends, so earlier lessons may already be committed here; add to them.\n\n"
                    + "\n".join(lessons) + "\n", encoding="utf-8")
    return (f"gbase-run --repo {shlex.quote(str(ROOT))} --slot work --task-file {shlex.quote(str(path))} "
            "--worktree lessons --exclusive")


def cmd_run(argv):
    p = argparse.ArgumentParser(prog="gbase-run", description="Run one gbase orchestrator slot headless.")
    p.add_argument("--repo")
    p.add_argument("--dir", help="task/content only: run in this folder, git or not, with no worktree, base, or "
                                 "concurrent-run check")
    p.add_argument("--slot")
    task_arg = p.add_mutually_exclusive_group()
    task_arg.add_argument("--task", default="")
    task_arg.add_argument("--task-file", help="read the task from a file, so a long task needs no shell quoting")
    p.add_argument("--worktree")
    p.add_argument("--base", help="ref a new --worktree branch starts from and result.json's base counts against "
                                  "(default: origin's default branch, fetched first)")
    p.add_argument("--model")
    p.add_argument("--ship-owner", choices=["orchestrator", "agent"], help="default: the answered run's, else orchestrator")
    p.add_argument("--answers")
    p.add_argument("--exclusive", action="store_true",
                   help="one --exclusive run at a time on the repo (same origin URL), each starting once the runs "
                        "going there when its turn came have ended")
    a = p.parse_args(argv)
    detached = os.environ.pop("GBASE_DETACHED", None) == "1"  # set by `gbase-run start`; popped so claude doesn't inherit it

    answers, prev = None, {}
    if a.answers:
        answers = json.loads(Path(a.answers).read_text(encoding="utf-8"))
        if answers.get("run_id"):
            prev_path = RUNS / answers["run_id"] / "result.json"
            if not prev_path.exists():
                sys.exit(f"gbase-run: no run {answers['run_id']}")
            prev = json.loads(prev_path.read_text(encoding="utf-8"))
    if a.task_file:
        a.task = Path(a.task_file).expanduser().read_text(encoding="utf-8").strip()
    folder, repo = (a.dir, a.repo) if a.dir or a.repo else (prev.get("dir"), prev.get("repo"))
    slot = a.slot or prev.get("slot")
    task = a.task or prev.get("task", "")
    a.ship_owner = a.ship_owner or prev.get("ship_owner") or "orchestrator"
    if not (repo or folder) or not slot:
        p.error("--repo (or --dir) and --slot are required (or --answers naming a previous run_id)")
    if folder:
        if a.repo or a.worktree or a.base or a.exclusive:
            p.error("--dir runs without git: drop --repo, --worktree, --base, and --exclusive")
        if slot not in DIR_SLOTS:
            p.error(f"--dir is for the {' and '.join(sorted(DIR_SLOTS))} slots; slot {slot} needs a --repo")
        given = Path(folder).expanduser().resolve()
        if not given.is_dir():
            sys.exit(f"gbase-run: {given} is not a directory")
        repo = None
    else:
        given = Path(repo).expanduser().resolve()
        if git(given, "rev-parse", "--git-dir") is None:
            sys.exit(f"gbase-run: {given} is not a git repository")
        repo = main_checkout(given)  # recorded as the repo; claude still runs in `given` without --worktree

    manifest = json.loads((PLUGIN_DIR / ".claude-plugin" / "factory.json").read_text(encoding="utf-8"))
    spec = manifest["slots"].get(slot)
    if spec is None:
        sys.exit(f"gbase-run: unknown slot {slot!r}; factory.json has {', '.join(manifest['slots'])}")
    if not task and re.search(r"<[^>]+>", spec["invoke"] or ""):
        sys.exit(f"gbase-run: slot {slot} needs --task for {spec['invoke']!r}")
    PLUGIN_DIRS[:] = plugin_dirs(slot, spec["invoke"])
    # the answered run's model only on the same slot: a work run's opus isn't a ship run's choice
    model = a.model or (prev.get("model") if slot == prev.get("slot") else None) or spec.get("model")
    if spec.get("models") and model:
        print(f"gbase-run: slot {slot} runs {', '.join(spec['models'])}; --model {model} ignored", file=sys.stderr)

    # a follow-up run continues in the previous run's checkout, where its edits are
    same_repo = bool(repo and prev.get("repo")) and str(main_checkout(Path(prev["repo"]))) == str(repo)
    base = repo and resolve_base(repo, a.base or (same_repo and (prev.get("base") or {}).get("ref")) or None)
    cwd = None if a.worktree else Path(prev["cwd"] if same_repo and prev.get("cwd") else given)
    run_id = f"{time.strftime('%Y%m%d-%H%M%S')}-{slot}-{secrets.token_hex(3)}"
    run_dir = RUNS / run_id
    run_dir.mkdir(parents=True)
    result_path = run_dir / "result.json"
    prompt = build_prompt(slot, spec, task, answers)
    (run_dir / "prompt.txt").write_text(prompt + "\n", encoding="utf-8")
    if answers:
        write_json(run_dir / "answers.json", answers)

    env = {k: v for k, v in os.environ.items() if k != "GITHUB_TOKEN"}  # a stale token breaks gh here
    env.update({
        "AGENT_HEADLESS": "1",
        "AGENT_SHIP_OWNER": a.ship_owner,
        "AGENT_PR_BODY_FILE": str(run_dir / "pr-body.md"),
        "AGENT_EVIDENCE_FILE": str(run_dir / "evidence.jsonl"),
        "AGENT_ASK_CMD": os.environ.get("GBASE_ASK_CMD")
        or f"{shlex.quote(sys.executable)} {shlex.quote(str(Path(__file__).resolve()))} question {run_id}",
    })
    (run_dir / "evidence.jsonl").touch()

    models = spec.get("models") or [model]
    result = {
        "run_id": run_id, "status": "running", "slot": slot, "task": task, "repo": repo and str(repo),
        "dir": folder and str(given),
        "cwd": str(cwd) if cwd else None,
        "worktree": a.worktree, "model": model, "ship_owner": a.ship_owner,
        "answers_from": (answers or {}).get("run_id"), "pid": os.getpid(), "started_at": now(),
        **({"waiting": True} if a.exclusive else {}),
        "finished_at": None, "run_dir": str(run_dir), "prompt_path": str(run_dir / "prompt.txt"),
        "log_path": str(run_dir / ("log.jsonl" if len(models) == 1 else f"log-{models[0]}.jsonl")),
    }
    write_json(result_path, result)
    if detached:  # the caller has the run now; everything the runner prints after this goes to runner.log
        print(f"{run_id}\n{result_path}", flush=True)
        log = os.open(run_dir / "runner.log", os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
        os.dup2(log, 1)
        os.dup2(log, 2)
        os.close(log)

    def stop(signum, _frame):  # end the children too; the threads then finish and finally records the run
        result["stopped_by"] = signal.Signals(signum).name
        STOPPING.set()
        for proc in PROCS:
            killpg(proc, signal.SIGTERM)
        # the whole group, even when claude itself exited: a grandchild ignoring SIGTERM holds the stdout pipe
        escalate = threading.Timer(STOP_GRACE, lambda: [killpg(p, signal.SIGKILL) for p in PROCS])
        escalate.daemon = True  # a group that exits in time doesn't hold the runner for the grace period
        escalate.start()

    for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):  # HUP: the terminal closed; claude is in its own group
        signal.signal(sig, stop)
    sessions, created = {}, False
    accounts = Accounts(env, task, prefer=prev.get("account"))
    try:
        key = repo and repo_key(repo)
        concurrent = running_on(key, run_id) if key else []
        if concurrent:
            result["concurrent"] = concurrent
            write_json(result_path, result)
            print(f"gbase-run: running on the same repo ({key}): {', '.join(concurrent)}"
                  + ("; waiting for them to end (--exclusive)" if a.exclusive else ""), file=sys.stderr)
        if a.exclusive:
            # the kernel lock orders --exclusive runs that start in the same second and is freed when a runner
            # dies; held by this process until it exits
            lock_path = HOME / "locks" / f"{hashlib.sha1(key.encode()).hexdigest()[:12]}.lock"
            lock_path.parent.mkdir(parents=True, exist_ok=True)
            lock = open(lock_path, "w")
            while not STOPPING.is_set():
                try:
                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    STOPPING.wait(POLL)
            # the runs already going when the lock came; later ones aren't waited for, or a steady stream starves it
            ahead = set(running_on(key, run_id))
            while not STOPPING.is_set() and ahead & set(running_on(key, run_id)):
                STOPPING.wait(POLL)
            result.pop("waiting")
            write_json(result_path, result)
        # an account that can't log in or is at its limit is skipped before a worktree exists for it (runs d5bdaa
        # and ea5cd1 each left an empty worktree behind)
        if not STOPPING.is_set() and accounts.current() is None:
            print(f"gbase-run: no account can run: {accounts.failures[-1]}", file=sys.stderr)
        elif cwd is None and not STOPPING.is_set():  # after the wait, so a new branch starts from the latest base
            try:
                cwd, created = ensure_worktree(repo, a.worktree, base)
            except SystemExit as e:
                result["error"] = str(e.code)
                raise
            result["cwd"] = str(cwd)
            write_json(result_path, result)

        def one(m):
            log = run_dir / ("log.jsonl" if len(models) == 1 else f"log-{m}.jsonl")
            account, tries = accounts.current(), 0
            while account:
                try:
                    s = run_claude(prompt, cwd, account_env(env, account[1]), m, log, append=tries > 0)
                except OSError as e:  # claude binary missing or not executable
                    sessions[m or "default"] = {"log_path": str(log), "results": [], "exit_code": 127, "error": str(e)}
                    return
                s["account"], tries = account[0], tries + 1
                sessions[m or "default"] = s
                failed = prestart_failure(s)
                if not failed or STOPPING.is_set():
                    break
                accounts.fail(account, *failed)  # nothing ran: the same prompt on the next account
                account = accounts.current()
            if not account:
                return
            line = s["exit_code"] == 0 and s["session_id"] and not STOPPING.is_set() and unshipped(
                slot, a.ship_owner, s["results"], cwd, base)
            if not line:
                return
            try:
                more = run_claude(RESUME_PROMPT.format(line=line), cwd, account_env(env, account[1]), m, log,
                                  resume=s["session_id"])
            except OSError as e:  # the first session's report stays
                s["resume_error"] = str(e)
                return
            costs = [c for c in (s["cost_usd"], more["cost_usd"]) if c is not None]
            s.update(results=s["results"] + more["results"], exit_code=more["exit_code"], resumed=True,
                     cost_usd=sum(costs) if costs else None)

        threads = [threading.Thread(target=one, args=(m,)) for m in models] if cwd and not STOPPING.is_set() else []
        for t in threads:
            t.start()
        for t in threads:
            t.join()
    finally:
        sessions = {k: sessions[k] for k in (m or "default" for m in models) if k in sessions}  # manifest order
        idle = [s for s in sessions.values() if prestart_failure(s)]
        skills = list(dict.fromkeys([*re.findall(r"^/([\w-]+:[\w-]+)", prompt),
                                     *(k for s in sessions.values() for k in s.get("skills", []))]))
        for s in sessions.values():
            for k in ("errors", "skills", "is_error"):
                s.pop(k, None)
        results = {m: s.pop("results") for m, s in sessions.items()}
        finals = {m: final_text(texts) for m, texts in results.items()}
        for m, text in finals.items():
            name = "final.md" if len(models) == 1 else f"final-{m}.md"
            (run_dir / name).write_text(text, encoding="utf-8")
            sessions[m]["final_path"] = str(run_dir / name)
        parsed = [report("\n".join(texts)) for texts in results.values()]
        decisions = list({d["text"]: d for r in parsed for d in r["decisions"]}.values())
        pr_line = next((r["pr_body_line"] for r in parsed if r["pr_body_line"]), None)
        pr_draft = run_dir / "pr-body.md"
        exit_code = max((s.get("exit_code", 1) for s in sessions.values()), default=1)
        lessons = list(dict.fromkeys(line for r in parsed for line in r["lessons"]))
        # a session that opened a PR may end without its `pr:` line (go → monitor ran long and the last message
        # kept only `settle:`; run 20261029-220851-work-a4b9c7): look the branch's PR up
        looks_up = slot == "settle" or (slot in SHIPPING_SLOTS and a.ship_owner == "agent")
        pr_url = next((r["pr_url"] for r in parsed if r["pr_url"]), None) or (
            pr_url_of(cwd) if looks_up and cwd and not STOPPING.is_set() else None)
        status = "done" if exit_code == 0 and len(sessions) == len(models) else "failed"
        head_sha = repo and cwd and git(cwd, "rev-parse", "HEAD")
        # a local-only run (no origin, nothing pushed) is finished only once its commits are on the branch the
        # repo's other jobs use
        landed = None
        if repo and cwd and base and a.ship_owner == "orchestrator" and git(repo, "remote", "get-url", "origin") is None:
            landed = {"ref": base, "contains_head": git(cwd, "merge-base", "--is-ancestor", "HEAD", base) is not None}
        branch = repo and cwd and git(cwd, "rev-parse", "--abbrev-ref", "HEAD")
        # what ended the run when no session got past a login or usage-limit error
        failure = accounts.failures[-1] if status == "failed" and accounts.failures and len(idle) == len(sessions) else None
        land_hint = (f"커밋 {head_sha[:7]}는 {branch}에만 있음. {base}에 넣으려면 `gbase-run land {run_id}`"
                     if landed and not landed["contains_head"] and head_sha else None)
        result.update({
            "status": status,
            "finished_at": now(),
            "exit_code": exit_code,
            # a --dir folder inside some git tree isn't that repo's run
            "branch": branch,
            "head_sha": head_sha,
            "base": cwd and base_counts(cwd, base),
            "landed": landed,
            "account": next((s["account"] for s in sessions.values() if s.get("account")), None),
            "failures": accounts.failures,
            "failure": failure,
            "skills": skills,
            "decisions": decisions,
            "questions": read_jsonl(run_dir / "questions.jsonl"),
            "ship": next((r["ship"] for r in parsed if r["ship"]), None),
            "pr_body_file": pr_line or (str(pr_draft) if pr_draft.exists() else None),
            "settle": next((r["settle"] for r in parsed if r["settle"]), None),
            "pr_url": pr_url,
            "mockup": next((r["mockup"] for r in parsed if r["mockup"]), None),
            "evidence": read_jsonl(run_dir / "evidence.jsonl"),
            "lessons": lessons,
            # a work run ships lessons; any other run's go to one, on a fresh worktree of this checkout
            "next": write_lessons(run_id, run_dir, lessons) if lessons and slot != "work" else land_hint,
            "sessions": sessions,
        })
        if (run_dir / "stop-reason").exists():
            result["stop_reason"] = (run_dir / "stop-reason").read_text(encoding="utf-8").strip()
        child_signal = {-15: "SIGTERM", 143: "SIGTERM", -9: "SIGKILL", 137: "SIGKILL", -2: "SIGINT", 130: "SIGINT"}
        if not result.get("stopped_by") and exit_code in child_signal:  # claude itself was signaled, not by stop
            result["stopped_by"] = f"child {child_signal[exit_code]}"
        # a worktree made for a run that never got to work goes at once; failed runs' worktrees piled up to 99 GB
        if result["failure"] and created and cwd and not git(cwd, "status", "--porcelain") and (
                not base or git(cwd, "rev-list", "--count", f"{base}..HEAD") == "0"):
            result["worktree_removed"] = remove_worktree(repo, cwd, branch)
        result["provenance"] = provenance(result)
        if len(models) > 1:
            findings = merge_reviews(finals)
            (run_dir / "review.md").write_text(review_md(findings, models), encoding="utf-8")
            result.update({"findings": findings, "report_file": str(run_dir / "review.md")})
        write_json(result_path, result)
        if result["next"]:
            print(f"next: {result['next']}")
        print(result_path)
    return 0 if result["status"] == "done" else 1


def cmd_start(argv):
    """`gbase-run start <run args>`: the run in a new session, detached from the caller. Returns once result.json
    exists, printing the run id and its path, so a bot's command needs no nohup, redirect, or permission flag."""
    proc = subprocess.Popen([sys.executable, str(Path(__file__).resolve()), *argv],
                            env={**os.environ, "GBASE_DETACHED": "1"}, stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True)
    out, err = proc.stdout.read(), proc.stderr.read()  # EOF once the runner moved its output to runner.log, or exited
    sys.stderr.write(err)  # warnings from before the run detached, or why it failed to start (a bad argument)
    if out.strip():
        print(out.strip())
        return 0
    return proc.wait() or 1


def killpg(proc, sig):
    try:
        os.killpg(proc.pid, sig)
    except (ProcessLookupError, PermissionError):
        pass


def pid_alive(pid, started_at=None):
    """pid runs and, given its run's started_at, didn't start after it: a dead runner's pid reused by a later
    process would otherwise keep the run `running` and an --exclusive run waiting on it forever."""
    try:
        os.kill(pid, 0)
    except (OSError, TypeError):
        return False
    if not started_at:
        return True
    try:
        ps = subprocess.run(["ps", "-o", "lstart=", "-p", str(pid)], capture_output=True, text=True, timeout=10,
                            env={**os.environ, "LC_ALL": "C"})
        began = time.mktime(time.strptime(ps.stdout.strip(), "%a %b %d %H:%M:%S %Y"))
        run = datetime.strptime(started_at, "%Y-%m-%dT%H:%M:%S%z").timestamp()
    except (OSError, subprocess.TimeoutExpired, ValueError):  # no ps here: the pid check alone
        return True
    return began <= run + 1


def load_result(run_id):
    path = RUNS / run_id / "result.json"
    if not path.exists():
        return None
    result = json.loads(path.read_text(encoding="utf-8"))
    if result.get("status") == "running" and not pid_alive(result.get("pid"), result.get("started_at")):
        result["status"] = "dead"  # the runner died before writing its final result
    return result


def cmd_status(argv):
    if len(argv) != 1:
        sys.exit("usage: gbase-run status <run-id>")
    result = load_result(argv[0])
    if result is None:
        sys.exit(f"gbase-run: no run {argv[0]}")
    print(json.dumps(result, ensure_ascii=False, indent=2))


def cmd_stop(argv):
    """SIGTERM a run's runner; it ends each claude process group and writes result.json (`stopped_by`, and
    `stop_reason` from --reason)."""
    p = argparse.ArgumentParser(prog="gbase-run stop")
    p.add_argument("run_id")
    p.add_argument("--reason")
    a = p.parse_args(argv)
    result = load_result(a.run_id)
    if result is None:
        sys.exit(f"gbase-run: no run {a.run_id}")
    if result["status"] == "running":
        if a.reason:  # read by the runner as it writes its final result
            (RUNS / a.run_id / "stop-reason").write_text(a.reason + "\n", encoding="utf-8")
        try:
            os.kill(result["pid"], signal.SIGTERM)
        except (ProcessLookupError, PermissionError) as e:
            sys.exit(f"gbase-run: can't signal runner pid {result['pid']}: {e}")
        deadline = time.time() + STOP_GRACE + 20
        while pid_alive(result["pid"]) and time.time() < deadline:
            time.sleep(0.2)
        result = load_result(a.run_id)
    print(json.dumps({k: result.get(k) for k in ("run_id", "status", "stopped_by", "stop_reason", "finished_at")},
                     ensure_ascii=False))
    return 1 if result["status"] == "running" else 0


def cmd_list(_argv):
    for d in sorted(RUNS.glob("*/result.json"), reverse=True):
        r = load_result(d.parent.name)
        print(json.dumps({k: r.get(k) for k in ("run_id", "status", "slot", "repo", "dir", "started_at", "exit_code")},
                         ensure_ascii=False))


def provenance(r):
    """One line naming who did a run, for a bot to put on what it relays: `Claude Code · opus · 계정 default ·
    run <id> · 스킬 gbase:work→go`."""
    sessions = r.get("sessions") or {}
    model = r.get("model") or (" + ".join(sessions) if len(sessions) > 1 else
                               next((s.get("model") for s in sessions.values() if s.get("model")), None))
    parts = ["Claude Code", model or "기본 모델", f"계정 {r.get('account') or 'default'}", f"run {r['run_id']}"]
    chain, plugin = [], None
    for skill in (r.get("skills") or [])[:4]:
        owner, _, name = skill.partition(":")
        chain.append(name if owner == plugin else skill)
        plugin = owner
    if chain:
        parts.append("스킬 " + "→".join(chain) + ("→…" if len(r["skills"]) > 4 else ""))
    return " · ".join(parts)


def cmd_cite(argv):
    if len(argv) != 1:
        sys.exit("usage: gbase-run cite <run-id>")
    result = load_result(argv[0])
    if result is None:
        sys.exit(f"gbase-run: no run {argv[0]}")
    print(result.get("provenance") or provenance(result))


def worktrees(repo):
    """[(path, branch or None)] of repo's worktrees, the main checkout first."""
    out = []
    for block in (git(repo, "worktree", "list", "--porcelain") or "").split("\n\n"):
        lines = block.splitlines()
        if lines:
            out.append((Path(lines[0].removeprefix("worktree ")),
                        next((ln.removeprefix("branch refs/heads/") for ln in lines if ln.startswith("branch ")), None)))
    return out


def checked_out_at(repo, branch, linked_only=False):
    """The worktree that has branch checked out, or None."""
    return next((path for path, b in worktrees(repo)[linked_only:] if b == branch), None)


def cmd_land(argv):
    """`land <run-id> [--onto <branch>]`: put a local-only run's commits on a local branch (default: its
    `landed.ref`, else its base) by fast-forward, else by cherry-picking them; stops on a conflict or on uncommitted
    changes where the branch is checked out, changing nothing."""
    p = argparse.ArgumentParser(prog="gbase-run land")
    p.add_argument("run_id")
    p.add_argument("--onto")
    a = p.parse_args(argv)
    r = load_result(a.run_id)
    if r is None:
        sys.exit(f"gbase-run: no run {a.run_id}")
    if r.get("status") == "running" or not r.get("repo") or not r.get("head_sha"):
        sys.exit(f"gbase-run: run {a.run_id} is {r.get('status')} with head {r.get('head_sha')}; nothing to land")
    repo, head = Path(r["repo"]), r["head_sha"]
    onto = a.onto or (r.get("landed") or {}).get("ref") or (r.get("base") or {}).get("ref")
    old = onto and git(repo, "rev-parse", "--verify", "--quiet", f"refs/heads/{onto}")
    if not old:
        sys.exit(f"gbase-run: --onto must name a local branch of {repo} (got {onto})")
    # commits whose patch onto already has (an earlier land's picks) are left out, or their empty pick stops it
    pick_range = ("--cherry-pick", "--right-only", f"{old}...{head}")
    commits = (git(repo, "rev-list", "--reverse", "--no-merges", *pick_range) or "").split()
    if git(repo, "merge-base", "--is-ancestor", head, old) is not None or not commits:
        method, new = "already", old
    elif git(repo, "merge-base", "--is-ancestor", old, head) is not None:
        method, new = "fast-forward", head
    else:
        method = "cherry-pick"
        if len(commits) != int(git(repo, "rev-list", "--count", *pick_range) or 0):
            sys.exit(f"gbase-run: {old[:7]}..{head[:7]} has merge commits; land it by hand")
        # picked in a scratch worktree, so the user's checkout of onto isn't touched until it can fast-forward
        tmp = HOME / "land" / a.run_id
        if git(repo, "worktree", "add", "--detach", str(tmp), old) is None:
            sys.exit(f"gbase-run: couldn't create a scratch worktree at {tmp}")
        try:
            pick = subprocess.run(["git", "-C", str(tmp), "cherry-pick", *commits], capture_output=True, text=True)
            if pick.returncode:
                conflicts = git(tmp, "diff", "--name-only", "--diff-filter=U") or pick.stderr.strip()
                git(tmp, "cherry-pick", "--abort")
                sys.exit(f"gbase-run: cherry-picking onto {onto} stopped on a conflict; nothing changed:\n{conflicts}")
            new = git(tmp, "rev-parse", "HEAD")
        finally:
            remove_worktree(repo, tmp)
    if method != "already":
        wt = checked_out_at(repo, onto)
        if wt and git(wt, "status", "--porcelain", "--untracked-files=no"):
            sys.exit(f"gbase-run: {onto} is checked out at {wt} with uncommitted changes; commit or stash them and "
                     "run land again")
        moved = (git(wt, "merge", "--ff-only", "--quiet", new) if wt
                 else git(repo, "update-ref", f"refs/heads/{onto}", new, old))
        if moved is None:
            sys.exit(f"gbase-run: couldn't move {onto} to {new[:7]}")
    r["landed"] = {"ref": onto, "contains_head": True, "sha": new, "method": method}
    if "gbase-run land" in (r.get("next") or ""):
        r["next"] = None
    write_json(RUNS / a.run_id / "result.json", r)
    print(json.dumps({"run_id": a.run_id, "onto": onto, "method": method, "from": old, "to": new}, ensure_ascii=False))


def parse_age(text):
    m = re.fullmatch(r"(\d+)([dhm])", text.strip())
    if not m:
        raise argparse.ArgumentTypeError(f"{text!r}: use <n>d, <n>h, or <n>m")
    return int(m.group(1)) * {"d": 86400, "h": 3600, "m": 60}[m.group(2)]


def gc_reason(repo, path, branch, run, max_age):
    """Why a worktree may go (a string starting `remove:`), or why it stays."""
    if run is None:
        return "keep: no gbase run used it"
    if run.get("status") not in ("done", "failed", "dead"):  # dead: the runner crashed, the run is over
        return f"keep: run {run['run_id']} is {run.get('status')}"
    exact = Path(run.get("cwd") or "") == path
    try:
        ended = datetime.strptime(run.get("finished_at") or "", "%Y-%m-%dT%H:%M:%S%z").timestamp() if exact else None
    except ValueError:
        ended = None
    if time.time() - (ended or path.stat().st_mtime) < max_age:
        return "keep: newer than --older-than"
    dirty = git(path, "status", "--porcelain")
    if dirty is None:
        return "keep: git status failed"
    if dirty:
        return "keep: uncommitted changes"
    base = (run.get("base") or {}).get("ref") or resolve_base(repo, None)
    if base:
        if git(path, "rev-list", "--count", f"{base}..HEAD") == "0":
            return f"remove: 0 commits not in {base}"
        cherry = git(path, "cherry", base, "HEAD")
        if cherry is not None and not any(ln.startswith("+") for ln in cherry.splitlines()):
            return f"remove: every commit is in {base} (squashed or landed by cherry-pick)"
    if branch:
        # ensure_worktree renames a branch whose PR ended to <branch>-pr<N>; its PR is under the old name
        renamed = re.match(r"(.+)-pr(\d+)$", branch)
        pr = head_pr(repo, renamed.group(1) if renamed else branch)
        if renamed and pr and str(pr.get("number")) != renamed.group(2):
            pr = head_pr(repo, branch)
        if pr and pr.get("state") in ("MERGED", "CLOSED"):
            return f"remove: PR #{pr['number']} {pr['state']}"
    return "keep: commits not in the base and no ended PR"


def cmd_gc(argv):
    """`gc [--older-than 3d] [--dry-run]`: remove $GBASE_HOME/worktrees/* whose last run is done or failed, that
    have no uncommitted changes, and whose work is in the base, in a merged or closed PR, or was never made. Branches
    stay; one JSON line per worktree."""
    p = argparse.ArgumentParser(prog="gbase-run gc")
    p.add_argument("--older-than", type=parse_age, default=parse_age("3d"))
    p.add_argument("--dry-run", action="store_true")
    a = p.parse_args(argv)
    runs = sorted((r for r in (load_result(d.parent.name) for d in RUNS.glob("*/result.json")) if r and r.get("repo")),
                  key=lambda r: r["run_id"])
    last = {}  # worktree path → the newest run there; a running one wins
    for r in runs:
        if r.get("cwd") and last.get(r["cwd"], {}).get("status") != "running":
            last[r["cwd"]] = r
    root = HOME / "worktrees"
    for repo in sorted({str(main_checkout(Path(r["repo"]))) for r in runs if Path(r["repo"]).is_dir()}):
        repo = Path(repo)
        for path, branch in worktrees(repo)[1:]:
            path = path.resolve()
            if path.parent != root.resolve() or not path.is_dir():
                continue
            run = last.get(str(path)) or last.get(re.sub(r"(-pr\d+)+$", "", str(path)))
            reason = gc_reason(repo, path, branch, run, a.older_than)
            action = reason.split(":")[0]
            if action == "remove" and a.dry_run:
                action = "would remove"
            elif action == "remove" and not remove_worktree(repo, path):
                action, reason = "keep", "keep: git worktree remove failed"
            print(json.dumps({"path": str(path), "branch": branch, "run_id": run and run["run_id"], "action": action,
                              "reason": reason.split(": ", 1)[1]}, ensure_ascii=False))
        if not a.dry_run:
            git(repo, "worktree", "prune")


def cmd_question(argv):
    """AGENT_ASK_CMD for runs: `question <run-id> [ask] "<q>" --recommend "<o>" [--option "<o>"]...`
    (headless.md's `sh -c` form passes `ask` as $0, so the verb usually doesn't arrive).
    Records the question and answers it only from the run's --answers file (exact match first, then
    normalize_decision); otherwise prints nothing, so the skill applies its recommendation and writes a `결정 필요:` line."""
    run_dir = RUNS / argv[0]
    q = argparse.ArgumentParser()
    q.add_argument("words", nargs="+")
    q.add_argument("--recommend")
    q.add_argument("--option", action="append", default=[])
    a, _ = q.parse_known_args(argv[1:])
    a.question = a.words[-1]
    with open(run_dir / "questions.jsonl", "a", encoding="utf-8") as f:
        f.write(json.dumps({"question": a.question, "recommend": a.recommend, "options": a.option}, ensure_ascii=False) + "\n")
    answers = run_dir / "answers.json"
    if answers.exists():
        known = json.loads(answers.read_text(encoding="utf-8")).get("answers", [])
        exact = [ans["answer"] for ans in known if str(ans.get("decision") or "").strip() == a.question.strip()]
        key = normalize_decision(a.question)
        fuzzy = {ans["answer"] for ans in known if key and normalize_decision(str(ans.get("decision") or "")) == key}
        if exact or len(fuzzy) == 1:  # answers that disagree on the normalized text give none
            print((exact or list(fuzzy))[0])


SENTENCE_PUNCT = set("?!,.:;'\"？！，。：；、‘’“”「」")


def normalize_decision(text):
    """Keeps only the question of a pasted `결정 필요:` line (no prefix, `→` tail, or `(…)` group), casefolds, and turns each run of whitespace and sentence punctuation
    into one space, so `v1.2.0` and `v12.0` stay apart while `Use the cache?` matches `use the cache`.
    Symbols that carry meaning (`-`, `#`, `%`, `_`) stay, so `-1` and `1` or `C#` and `C` don't match."""
    if DECISION_PREFIX.match(text):
        text = parse_decision(text)["question"]
    text = text.casefold()
    text = "".join(" " if c.isspace() or c in SENTENCE_PUNCT else c for c in text)
    return " ".join(text.split())


def main():
    argv = sys.argv[1:]
    commands = {"start": cmd_start, "status": cmd_status, "stop": cmd_stop, "list": cmd_list, "question": cmd_question,
                "cite": cmd_cite, "land": cmd_land, "gc": cmd_gc}
    if argv and argv[0] in commands:
        return commands[argv[0]](argv[1:]) or 0
    return cmd_run(argv)


if __name__ == "__main__":
    sys.exit(main())
