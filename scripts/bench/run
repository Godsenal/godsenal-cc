def scratch_repo(task, root):
    repo = root / "repo"
    shutil.copytree(FIXTURES / task, repo, ignore=shutil.ignore_patterns("__pycache__"))
    env = {**os.environ, "GIT_AUTHOR_NAME": "bench", "GIT_AUTHOR_EMAIL": "bench@localhost",
           "GIT_COMMITTER_NAME": "bench", "GIT_COMMITTER_EMAIL": "bench@localhost"}
    for cmd in (["init", "-q", "-b", "main"], ["add", "-A"], ["commit", "-q", "-m", "init"]):
        subprocess.run(["git", "-C", str(repo), *cmd], check=True, env=env)
    return repo


def bench_env(root):
    bin_dir = root / "bin"
    bin_dir.mkdir()
    gh = bin_dir / "gh"
    gh.write_text(FAKE_GH, encoding="utf-8")
    gh.chmod(0o755)
    env = {k: v for k, v in os.environ.items() if not k.startswith("AGENT_")}
    # the bench's own GBASE_HOME hides the real accounts file, so a run would get no account switching
    accounts = Path(os.environ.get("GBASE_HOME") or "~/.gbase").expanduser() / "accounts"
    if "GBASE_ACCOUNTS" not in env and accounts.is_file():
        env["GBASE_ACCOUNTS"] = accounts.read_text(encoding="utf-8")
    return {**env, "PATH": f"{bin_dir}{os.pathsep}{os.environ.get('PATH', '')}",
            "GBASE_HOME": str(root / "home"), "BENCH_GH_LOG": str(root / "gh.log")}


KILL_GRACE = 30  # gbase-run's own STOP_GRACE (10 s) to end its claude groups, plus writing result.json


def run_runner(cmd, env, timeout):
    """(returncode, stdout, stderr); past timeout, None. Each claude runs in its own process group that only
    gbase-run's SIGTERM handler ends, so gbase-run gets SIGTERM first and SIGKILL only if it outlives its grace."""
    proc = subprocess.Popen(cmd, env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                            start_new_session=True)
    try:
        out, err = proc.communicate(timeout=timeout)
        return proc.returncode, out, err
    except subprocess.TimeoutExpired:
        proc.send_signal(signal.SIGTERM)
        try:
            out, err = proc.communicate(timeout=KILL_GRACE)
        except subprocess.TimeoutExpired:
            os.killpg(proc.pid, signal.SIGKILL)
            out, err = proc.communicate()
        return None, out, (err or "") + f"\nbench: stopped after {timeout}s"


def run_one(task, n, out, timeout=1800):
    spec = TASKS[task]
    root = out / f"{task}-{n}"
    if root.exists():
        shutil.rmtree(root)
    root.mkdir(parents=True)
    repo = scratch_repo(task, root)
    code, stdout, stderr = run_runner([sys.executable, str(RUNNER), "--repo", str(repo), "--slot", "work",
                                       "--task", spec["task"], "--max-budget-usd", str(spec["budget"])],
                                      bench_env(root), timeout)
    lines = stdout.strip().splitlines()
    try:
        if code is None:
            raise ValueError("timeout")
        result = json.loads(Path(lines[-1]).read_text(encoding="utf-8"))
    except (IndexError, OSError, ValueError):
        return {"task": task, "n": n, "pass": False, "error": (stderr or stdout)[-500:], "cost_usd": None}
    cwd = result.get("cwd") or str(repo)
    checks = {"go ran": "gbase:go" in (result.get("skills") or []),
              "ship: local": (result.get("ship") or "").startswith("ship: local"),
              "within budget": result.get("budget_limit") is None,
              **{label: bool(fn(result, cwd)) for label, fn in spec["checks"]}}
    gh_calls = read(root, "gh.log").splitlines()
    cost = sum(s.get("cost_usd") or 0 for s in (result.get("sessions") or {}).values())
    return {"task": task, "n": n, "run_id": result.get("run_id"), "status": result.get("status"),
            "seconds": result.get("duration_s"), "cost_usd": round(cost, 4), "tokens": result.get("tokens"),
            "budget_usd": spec["budget"], "budget_limit": result.get("budget_limit"), "risk": result.get("risk"),
            "checks": checks, "pass": result.get("status") == "done" and all(checks.values()),
            "gh_calls": len(gh_calls), "result": lines[-1]}


TOKEN_KEYS = ("fresh", "cache_read", "output")


def main_session(tokens):
    """result.json's tokens less its subagent part: the main-session count baseline.py's trend reports."""
    sub = tokens.get("subagent") if isinstance(tokens.get("subagent"), dict) else {}
    return {k: tokens[k] - (sub.get(k) or 0) for k in TOKEN_KEYS}


def summary(runs):
    out = {}
    for task in dict.fromkeys(r["task"] for r in runs):
        rs = [r for r in runs if r["task"] == task]
        secs = [r["seconds"] for r in rs if r.get("seconds") is not None]
        costs = [r["cost_usd"] for r in rs if r.get("cost_usd") is not None]
        toks = [main_session(r["tokens"]) for r in rs if isinstance(r.get("tokens"), dict)
                and all(k in r["tokens"] for k in TOKEN_KEYS)]
        risks = Counter(r["risk"] for r in rs if r.get("risk"))
        out[task] = {
            "runs": len(rs),
            "passed": sum(1 for r in rs if r["pass"]),
            "pass": all(r["pass"] for r in rs),
            "seconds": statistics.median(secs) if secs else None,
            "seconds_range": max(secs) - min(secs) if len(secs) > 1 else None,
            "cost_usd": statistics.median(costs) if costs else None,
            "risk": risks.most_common(1)[0][0] if risks else None,
            "risks": dict(risks),
            "tokens": {k: statistics.median(t[k] for t in toks) for k in TOKEN_KEYS} if toks else None,
        }
    return out


def write_bench(out, history, args, spent, skipped):
    bench = {"tasks": summary(history), "runs": history, "with": args.earlier, "spent_usd": round(spent, 4),
             "skipped": skipped, "max_total_usd": args.max_total_usd}
    (out / "bench.json").write_text(json.dumps(bench, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def main(argv=None):
    p = argparse.ArgumentParser(prog="bench/run")
    p.add_argument("--out", required=True)
    p.add_argument("--task", action="append", choices=list(TASKS), help="repeatable; default: every task but the hard ones")
    p.add_argument("--runs", type=int, default=1, help="runs per task")
    p.add_argument("--runs-low", type=int, help="runs of the low task (default --runs), to measure the noise")
    p.add_argument("--max-total-usd", type=float, default=20.0)
    p.add_argument("--run-timeout", type=int, default=1800, help="seconds before a run is killed and failed")
    p.add_argument("--with", dest="earlier", action="append", default=[],
                   help="an earlier bench.json whose runs join the summary (repeatable); its spend does not count")
    args = p.parse_args(argv)
    out = Path(args.out).resolve()
    out.mkdir(parents=True, exist_ok=True)
    earlier = [r for path in args.earlier for r in json.loads(Path(path).read_text(encoding="utf-8"))["runs"]]
    # number a top-up after the earlier runs, so it never reuses (and deletes) an earlier <task>-<n> folder
    first = {t: max((r["n"] for r in earlier if r["task"] == t), default=0) + 1 for t in TASKS}
    plan = [(t, n) for t in (args.task or [t for t in TASKS if not TASKS[t].get("hard")])
            for n in range(first[t], first[t] + (args.runs_low if t == "low" and args.runs_low is not None
                                                  else args.runs))]
    runs, spent, skipped = [], 0.0, []
    for task, n in plan:
        if spent + TASKS[task]["budget"] > args.max_total_usd:
            skipped.append(f"{task}-{n}")
            print(f"bench: skip {task}-{n} — ${spent:.2f} spent, its cap ${TASKS[task]['budget']:g} would pass "
                  f"--max-total-usd {args.max_total_usd:g}", file=sys.stderr)
            continue
        r = run_one(task, n, out, args.run_timeout)
        runs.append(r)
        spent += r["cost_usd"] if r.get("cost_usd") is not None else TASKS[task]["budget"]
        print(f"bench: {task}-{n} {'pass' if r['pass'] else 'fail'} {r.get('seconds')}s ${r.get('cost_usd')} "
              f"{r.get('checks') or r.get('error')}", file=sys.stderr, flush=True)
        write_bench(out, earlier + runs, args, spent, skipped)  # after every run, so a crash keeps what was paid for
    write_bench(out, earlier + runs, args, spent, skipped)
    print(f"bench: {out / 'bench.json'}")
    return 0 if runs and all(r["pass"] for r in runs) and not skipped else 1


if __name__ == "__main__":
    sys.exit(main())
