#!/usr/bin/env python3
"""Fixed bench tasks: one `gbase-run --slot work` per task on a scratch repo, timed and checked.

  scripts/bench/run --out <dir> [--task low --task medium …] [--runs 2] [--max-total-usd 20] [--with <earlier bench.json>]

Each run gets a fresh copy of scripts/bench/fixtures/<task>/ as a git repo with no remote, a `gh` on PATH that
answers nothing and records its arguments, and its own GBASE_HOME under <dir>, so nothing is pushed and the real
run history stays clean. gbase-run runs it headless with the orchestrator as ship owner (its defaults), capped at
the task's --max-budget-usd. A run starts only while what was spent plus that cap stays under --max-total-usd.

The hard tasks (rootcause, blast, mirror, strict) run only when named with --task, so a default bench stays
comparable with earlier ones. Each has a hidden test that fails on the fixture as given and on the plausible wrong fix
the fixture invites (a symptom patch, a change that breaks stored users, a test copied from the output, a commit that
ignores CONTRIBUTING.md); test_bench.py proves both, and a reference fix that passes. Each prompt also suggests that
wrong fix in the user's words ("report.py 에서 키를 고쳐 읽게 하면 될 것 같다"), because without the suggestion plain
Claude passed all four in a pilot: the trap is whether the harness checks a suggested fix before applying it.

<dir>/bench.json holds every run and, per task, the p50 of seconds, cost, and tokens, the pass count, the
seconds range across runs (the noise), and the risk tier most runs got. `--with <earlier bench.json>` adds that
file's runs to the summary, so a later invocation can top up the run count without repeating the spend. `baseline.py --bench <dir>/bench.json` puts it under `bench`.
"""
import argparse
import json
import os
import re
import shutil
import signal
import statistics
import subprocess
import sys
from collections import Counter
from pathlib import Path

HERE = Path(__file__).resolve().parent
FIXTURES = HERE / "fixtures"
RUNNER = HERE.parent / "gbase-run"
FAKE_GH = """#!/bin/sh
printf '%s\\n' "$*" >> "$BENCH_GH_LOG"
echo "gh: not available in the bench (nothing leaves this machine)" >&2
exit 1
"""


def run_tests(cwd, code):
    hidden = Path(cwd) / "tests" / "test_bench_hidden.py"
    hidden.write_text(code, encoding="utf-8")
    try:
        return subprocess.run([sys.executable, "-m", "unittest", "tests.test_bench_hidden"], cwd=cwd,
                              capture_output=True, timeout=120).returncode == 0
    except subprocess.TimeoutExpired:
        return False
    finally:
        hidden.unlink()


def read(cwd, rel):
    path = Path(cwd) / rel
    return path.read_text(encoding="utf-8", errors="replace") if path.is_file() else ""


