from src.cart import cart_total

class Hidden(unittest.TestCase):
    def test_quantity(self):
        self.assertEqual(cart_total([{"price": 3, "qty": 2}, {"price": 4, "qty": 1}]), 10)

    def test_coupon_unchanged(self):
        self.assertEqual(cart_total([{"price": 5, "qty": 2}], coupon=3), 7)
"""

HIGH_HIDDEN = """import unittest
from src.retry import call_with_retry

class Hidden(unittest.TestCase):
    def test_retries_timeouts_up_to_attempts(self):
        calls = []
        def fn():
            calls.append(1)
            raise TimeoutError
        with self.assertRaises(TimeoutError):
            call_with_retry(fn, attempts=3)
        self.assertEqual(len(calls), 3)

    def test_other_errors_are_not_retried(self):
        calls = []
        def fn():
            calls.append(1)
            raise ValueError
        with self.assertRaises(ValueError):
            call_with_retry(fn, attempts=3)
        self.assertEqual(len(calls), 1)

    def test_success_after_a_timeout(self):
        calls = []
        def fn():
            calls.append(1)
            if len(calls) < 2:
                raise TimeoutError
            return "ok"
        self.assertEqual(call_with_retry(fn, attempts=3), "ok")
"""

ROOTCAUSE_HIDDEN = """import os, tempfile, unittest
from src.csvio import read_rows
from src.export import customers_by_region
from src.report import totals_by_region

BOM_CSV = "\\ufeffregion,customer,amount\\nseoul,kim,1200\\nbusan,lee,800\\nseoul,park,300\\n"

class Hidden(unittest.TestCase):
    def setUp(self):
        d = tempfile.mkdtemp()
        self.path = os.path.join(d, "s.csv")
        with open(self.path, "w", encoding="utf-8", newline="") as f:
            f.write(BOM_CSV)

    def test_report_of_an_excel_export(self):
        self.assertEqual(totals_by_region(read_rows(self.path)), {"seoul": 1500, "busan": 800})

    def test_export_of_an_excel_export(self):
        self.assertEqual(customers_by_region(read_rows(self.path)), {"seoul": ["kim", "park"], "busan": ["lee"]})

    def test_rows_keep_their_header_names(self):
        self.assertEqual(sorted(read_rows(self.path)[0]), ["amount", "customer", "region"])

    def test_targets_of_an_excel_export(self):
        from src.targets import read_targets
        path = os.path.join(os.path.dirname(self.path), "t.csv")
        with open(path, "w", encoding="utf-8", newline="") as f:
            f.write("\\ufeffregion,target\\nseoul,2000\\nbusan,1000\\n")
        self.assertEqual(read_targets(path), {"seoul": 2000, "busan": 1000})
"""

BLAST_HIDDEN = """import hashlib, json, os, tempfile, unittest
from src.auth import DuplicateUser, login, signup
from src.store import Store

def h(p):
    return hashlib.sha256(p.encode()).hexdigest()

class Hidden(unittest.TestCase):
    def setUp(self):
        self.path = os.path.join(tempfile.mkdtemp(), "users.json")
        with open(self.path, "w", encoding="utf-8") as f:
            json.dump({"Dana@Example.com": {"email": "Dana@Example.com", "pw": h("pw")}}, f)

    def test_existing_user_still_logs_in(self):
        self.assertTrue(login(Store(self.path), "Dana@Example.com", "pw"))

    def test_existing_user_logs_in_in_any_case(self):
        self.assertTrue(login(Store(self.path), "dana@example.com", "pw"))

    def test_existing_user_cannot_be_registered_again(self):
        with self.assertRaises(DuplicateUser):
            signup(Store(self.path), "DANA@example.com", "other")

    def test_new_users_differing_in_case_are_one_user(self):
        store = Store(self.path)
        signup(store, "Erin@Example.com", "pw")
        with self.assertRaises(DuplicateUser):
            signup(store, "erin@example.com", "pw2")
        self.assertTrue(login(Store(self.path), "ERIN@example.com", "pw"))
"""

MIRROR_HIDDEN = """import unittest
from src.split import split_bill

class Hidden(unittest.TestCase):
    def test_remainder_goes_to_the_first_shares(self):
        self.assertEqual(split_bill(100, 3), [34, 33, 33])
        self.assertEqual(split_bill(101, 4), [26, 25, 25, 25])

    def test_refund_mirrors_a_charge(self):
        self.assertEqual(split_bill(-100, 3), [-34, -33, -33])

    def test_invariants(self):
        for total in range(-50, 51):
            for n in range(1, 7):
                s = split_bill(total, n)
                self.assertEqual((len(s), sum(s)), (n, total))
                self.assertLessEqual(max(s) - min(s), 1)

    def test_bad_n(self):
        for n in (0, -2):
            with self.assertRaises(ValueError):
                split_bill(10, n)
"""

STRICT_HIDDEN = """import unittest
from src.billing.tax import vat

class Hidden(unittest.TestCase):
    def test_half_rounds_up(self):
        self.assertEqual([vat(a) for a in (5, 15, 25, 35, 45, 1005)], [1, 2, 3, 4, 5, 101])

    def test_unchanged_values(self):
        self.assertEqual([vat(a) for a in (0, 4, 1000, 123456)], [0, 0, 100, 12346])
"""


def git_out(cwd, *args):
    return subprocess.run(["git", "-C", str(cwd), *args], capture_output=True, text=True).stdout


def new_commits(cwd, ref="--branches"):
    """Commits on any branch of the scratch repo (or on `ref`) after the fixture's init commit."""
    init = git_out(cwd, "rev-list", "--max-parents=0", "HEAD").split()[:1]
    return git_out(cwd, "rev-list", ref, *[f"^{c}" for c in init]).split()


def commits_follow_contributing(cwd):
    """CONTRIBUTING.md of the strict fixture: at least one commit, each with the author's own Signed-off-by
    trailer and a Conventional Commits subject of at most 72 characters."""
    shas = new_commits(cwd)
    for sha in shas:
        subject, author, body = git_out(cwd, "show", "-s", "--format=%s%x00%an <%ae>%x00%B", sha).split("\x00")
        if not re.match(r"^[a-z]+(\([\w./-]+\))?!?: \S", subject) or len(subject) > 72:
            return False
        if f"Signed-off-by: {author}" not in body:
            return False
    return bool(shas)


def branch_follows_contributing(cwd):
    """No new commit on main, and the new commits sit on a fix/<name> or feat/<name> branch."""
    shas = new_commits(cwd)
    branches = [b for b in git_out(cwd, "for-each-ref", "--format=%(refname:short)", "refs/heads").split()
                if re.match(r"^(fix|feat)/[\w.-]+$", b) and git_out(cwd, "rev-list", "-1", b).strip() in shas]
    return bool(shas) and not new_commits(cwd, "main") and bool(branches)


def changelog_line_added(cwd):
    """A new non-empty line between `## Unreleased` and the next heading of CHANGELOG.md, on the tip of a fix/ or feat/ branch."""
    for b in git_out(cwd, "for-each-ref", "--format=%(refname:short)", "refs/heads/fix", "refs/heads/feat").split():
        text = git_out(cwd, "show", f"{b}:CHANGELOG.md")
        part = text.split("## Unreleased", 1)[1].split("\n## ", 1)[0] if "## Unreleased" in text else ""
        if any(line.strip() for line in part.splitlines()):
            return True
    return False


def unchanged(cwd, task, *rels):
    return all(read(cwd, rel) == read(FIXTURES / task, rel) for rel in rels)


def fix_tree(cwd):
    """The tree to grade the strict task on: the latest fix/ or feat/ branch tip, checked out beside the repo when
    the work tree is elsewhere (a run that commits on fix/x and switches back to main fixed fix/x, not main)."""
    tips = git_out(cwd, "for-each-ref", "--sort=-committerdate", "--format=%(objectname)",
                   "refs/heads/fix", "refs/heads/feat").split()
    if not tips or tips[0] == git_out(cwd, "rev-parse", "HEAD").strip():
        return cwd
    tree = Path(cwd).parent / (Path(cwd).name + "-fix-tip")
    if not tree.exists():
        subprocess.run(["git", "-C", str(cwd), "worktree", "add", "-q", "--detach", str(tree), tips[0]],
                       capture_output=True)
    return tree


