#!/usr/bin/env python3
"""The mechanical steps of gbase:branch-pr. Each command prints `key: value` lines and ends with `next:` lines.

  ship-prep start [--local]             unwrap pause commits, back up the tree, report branch/files/conventions/compat
  ship-prep check <draft> [--local]     check a PR draft (line 1 title, line 2 empty, line 3 on the body)
  ship-prep preview <draft> [--partial] [--write [--reviewed]]
                                        print what a preview of the committed, unpushed change needs
                                        --write: save the preview text on stdin and record HEAD as the commit that was shown
                                        --reviewed: gbase:go's review and checks ran for it, so a later go skips them
  ship-prep open <draft> [--draft] [--partial] [--remote <name>] [--no-preview]
                                        check, push the branch, open the PR, print `pr: <url>`
                                        --partial: tracked files were left uncommitted on purpose (a secret, unrelated WIP)
                                        --no-preview: the request itself asked for the PR, so the preview setting yields
  ship-prep assets <file>...            upload images to the gbase-assets branch, print their embed lines

Exit codes: 0 ok, 1 error, 2 a person has to decide (the `ask:` lines say what), 3 nothing to ship.
"""
import base64
import hashlib
import fnmatch
import json
import os
import re
import subprocess
import sys
import tempfile
import time
from pathlib import Path

# by extension only: `requirements.txt`, `docs/openapi.yaml`, and `src/app/docs/page.tsx` are code
DOC_GLOBS = ("*.md", "*.mdx", "*.rst", "*.adoc", "LICENSE", "LICENSE.*", "CHANGELOG", "CHANGELOG.*", "NOTICE", ".gitignore")
TEST_GLOBS = ("test_*", "*_test.*", "*.test.*", "*.spec.*", "*/__tests__/*", "__tests__/*", "tests/*", "*/tests/*",
              "test/*", "*/test/*", "*/evals/*", "evals/*", "*/__snapshots__/*")
ASSET_GLOBS = ("*.png", "*.jpg", "*.jpeg", "*.gif", "*.webp", "*.svg", "*.ico", "*.mp4", "*.mov", "*.ttf", "*.otf", "*.woff*")
# branch-pr's risk rule without a REVIEW.md: these paths are `high`
HIGH_PATTERNS = (r"(^|/)auth", r"(^|/)(payments?|billing)(/|\.|$)", r"(^|/)migrations?/", r"\.sql$", r"^\.github/workflows/",
                 r"(^|/)(app\.json|app\.config\.[a-z]+|eas\.json|Info\.plist)$", r"(^|/)(release|deploy)[^/]*\.(ya?ml|sh)$")
SECRET_FILES = (".env", ".env.*", "*.pem", "*.p12", "*.pfx", "*.key", "*.keystore", "*.jks", "id_rsa*", "id_ed25519*",
                "credentials.json", "service-account*.json", ".npmrc", ".netrc")
SECRET_FILE_OK = (".env.example", ".env.sample", ".env.template", ".env.dist", "*.pub")
SECRET_PATTERNS = (
    ("private key", r"-----BEGIN [A-Z ]*PRIVATE KEY-----"),
    ("AWS access key", r"\bAKIA[0-9A-Z]{16}\b"),
    ("GitHub token", r"\bgh[pousr]_[A-Za-z0-9]{36,}\b|\bgithub_pat_[A-Za-z0-9_]{40,}\b"),
    ("API key (sk-)", r"\bsk-[A-Za-z0-9_-]{24,}\b"),
    ("Stripe key", r"\b[sr]k_(live|test)_[A-Za-z0-9]{16,}"),
    ("JWT", r"\beyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{10,}\."),
    ("Slack token", r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b"),
    ("Google API key", r"\bAIza[0-9A-Za-z_-]{35}\b"),
    # a name that says secret (also inside one: DB_PASSWORD, client_secret, STRIPE_SECRET_KEY) given a literal value:
    # quoted and 12+ long, or unquoted, 20+ long, and holding a digit (so `token = getTokenFromEnvironment` is not one)
    ("assigned secret", r"(?i)(api[_-]?key|secret|token|passwd|password|private[_-]?key|access[_-]?key)[A-Za-z0-9_]*[\"']?\s*[:=]\s*"
                        r"([\"'][A-Za-z0-9_\-/+=.]{12,}[\"']|(?=[A-Za-z0-9_\-/+=.]*\d)[A-Za-z0-9_\-/+=]{20,}(\s|$))"),
)
CONVENTION_FILES = r"(^|/)contributing\.md$|pull_request_template|commitlint|^\.husky/"
MAX_FOCUS_ITEMS = 5
# what a passing run did not show: a required behavior check that couldn't reach its surface, a check that ran on another kind of input
UNVERIFIED = r"behavior: skip|differs:"
CONFIRM_ITEM = r"^> \d+\. .*\((확인|verify)\)"  # a numbered Review focus item of the kind a person confirms
LEAD_LINES = 45  # body lines before ## Change outline: one screen
ENVIRONMENT_DOC = Path(__file__).resolve().parents[3] / "references" / "environment.md"
PREVIEW_DOC = Path(__file__).resolve().parents[1] / "references" / "preview.md"
PREVIEW_SETTING = r"^[\s>*_-]*`?before the PR[`*_]*\s*[:：][\s`*_]*preview\b"
POLICY_DOC = Path(__file__).resolve().parents[1] / "references" / "review-policy.md"
SIGNOFF_SETTING = r"^[\s>*_-]*`?commit sign[- ]?off[`*_]*\s*[:：][\s`*_]*on\b"
SIZE_SETTING = (r"^[\s>*_-]*`?PR size[`*_]*\s*[:：][\s`*_]*(\d[\d,]*)[`*_]*(?:\s*(?:lines?|줄))?[`*_]*"
                r"[ \t]*(?:(?:[,;]|\s[—–-])[ \t]*(ask)\b[^\n]*|\([^\n]*\)|\.)?[ \t\r]*$")
SIZE_LINE = r"^[\s>*_-]*`?PR size[`*_]*\s*[:：]"  # a line that names a size: one SIZE_SETTING can't read gets a note
LIST_SETTING = r"^[\s>*_-]*`?{key}[`*_]*\s*[:：][ \t`*_]*(\S.*)$"
REVIEWER = r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})(/[A-Za-z0-9][A-Za-z0-9_.-]*)?"  # a GitHub login, or org/team
SIZE_ITEM = r"^> 1\. .*\((크기|size)\)"  # Review focus item 1 that proposes the split, when the change is over PR size


class Stop(Exception):
    def __init__(self, code, lines):
        super().__init__(lines)
        self.code, self.lines = code, lines if isinstance(lines, list) else [lines]


def run(cmd, check=True, env=None, input=None):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, env=env, input=input)
    except OSError as e:  # gh not installed: the callers treat it like any failed command
        if check:
            raise Stop(1, f"error: can't run {cmd[0]} — {e.strerror}")
        return subprocess.CompletedProcess(cmd, 127, "", str(e))
    if check and p.returncode:
        raise Stop(1, [f"error: `{' '.join(cmd)}` exited {p.returncode}", p.stderr.strip() or p.stdout.strip()])
    return p


def git(*args, check=True, env=None):
    return run(["git", *args], check=check, env=env).stdout.strip()


def git_ok(*args):
    return run(["git", *args], check=False).returncode == 0


def matches(path, globs):
    name = path.rsplit("/", 1)[-1]
    return any(fnmatch.fnmatch(path, g) or fnmatch.fnmatch(name, g) for g in globs)


def file_kind(path):
    """doc / test / asset / code. Tests win over docs so a markdown fixture under tests/ counts as a test."""
    if matches(path, TEST_GLOBS):
        return "test"
    if matches(path, ASSET_GLOBS):
        return "asset"
    if matches(path, DOC_GLOBS):
        return "doc"
    return "code"


def compat_line(paths, base):
    """compat-check reviews deploy order; a change made only of docs, tests, and images has none to review."""
    kinds = sorted({file_kind(p) for p in paths})
    if paths and "code" not in kinds and not high_paths(paths):
        return f"compat: skip — only {'/'.join(kinds)} files changed"
    return f"compat: run — gbase:compat-check on {base}...HEAD"


def high_paths(paths):
    return [p for p in paths if any(re.search(pat, p, re.I) for pat in HIGH_PATTERNS)]


def risk_hint(paths):
    high = high_paths(paths)
    if high:
        return f"risk hint: high — {', '.join(high[:3])} (REVIEW.md, when the repo has one, decides)"
    if paths and all(file_kind(p) != "code" for p in paths):
        return "risk hint: low — docs/tests/assets only"
    return "risk hint: medium unless REVIEW.md marks a touched path always-high or the change is additive behind a flag"


def secret_hits(paths, added_lines):
    """[(where, kind)] — never the value."""
    hits = []
    for p in paths:
        if matches(p, SECRET_FILES) and not matches(p, SECRET_FILE_OK):
            hits.append((p, "secret-looking file"))
    for where, line in added_lines:
        for kind, pat in SECRET_PATTERNS:
            if re.search(pat, line):
                hits.append((where, kind))
                break
    return hits


def default_base():
    """(default branch name, the ref to diff against)."""
    head = git("symbolic-ref", "--short", "refs/remotes/origin/HEAD", check=False)
    candidates = ([head.split("/", 1)[1]] if "/" in head else []) + ["main", "master"]
    for prefix in ("origin/", ""):
        for name in candidates:
            if git_ok("rev-parse", "--verify", "-q", prefix + name):
                return name, prefix + name
    return None, None


def unwrap_pause():
    """Soft-reset the unpushed gbase:pause commits at the tip (`wip:` subject and an `Intent:` body line); returns their bodies."""
    n = 0
    while True:
        rev = f"HEAD~{n}"
        if not git_ok("rev-parse", "--verify", "-q", f"{rev}^"):  # never reset past the root commit
            break
        subject = git("log", "-1", "--format=%s", rev)
        body = git("log", "-1", "--format=%b", rev)
        if not subject.startswith("wip:") or not re.search(r"^Intent:", body, re.M):
            break
        if git("branch", "-r", "--contains", rev):
            break  # a pushed pause commit is never reset
        n += 1
    if not n:
        return []
    notes = [git("log", "-1", "--format=%B", f"HEAD~{i}") for i in range(n)]
    git("reset", "--soft", f"HEAD~{n}")
    return notes


def status_paths():
    out = run(["git", "status", "--porcelain=v1", "-z", "-uall"]).stdout
    entries, parts, i = [], out.split("\0"), 0
    while i < len(parts):
        e = parts[i]
        i += 1
        if not e:
            continue
        code, path = e[:2], e[3:]
        if code[0] in "RC":
            i += 1  # the rename's source path follows
        entries.append((code, path))
    return entries


def backup():
    """A commit of the whole tree (untracked included) under refs/gbase/backup/, from a copy of the index."""
    ts = time.strftime("%Y%m%d-%H%M%S") + f"-{os.getpid()}"
    fd, idx = tempfile.mkstemp()
    os.close(fd)
    try:
        Path(idx).write_bytes(Path(git("rev-parse", "--git-path", "index")).read_bytes())
        env = {**os.environ, "GIT_INDEX_FILE": idx}
        git("add", "-A", env=env)
        tree = git("write-tree", env=env)
    finally:
        os.unlink(idx)
    commit = git("commit-tree", tree, "-p", "HEAD", "-m", f"branch-pr-backup-{ts}")
    ref = f"refs/gbase/backup/{ts}"
    git("update-ref", ref, commit)
    stat = git("diff", "--stat", "HEAD", ref).splitlines()
    return ref, stat[-1].strip() if stat else "no changes"


def added_lines(entries, since="HEAD"):
    """(where, text) for every line the working tree adds on top of `since`, untracked files included."""
    lines, current = [], "?"
    for raw in run(["git", "diff", since, "--unified=0", "--no-color"], check=False).stdout.splitlines():
        if raw.startswith("+++ b/"):
            current = raw[6:]
        elif raw.startswith("+") and not raw.startswith("+++"):
            lines.append((current, raw[1:]))
    for code, path in entries:
        if code == "??":
            p = Path(path)
            try:
                if p.is_file() and p.stat().st_size < 1_000_000:
                    lines += [(f"{path}:{n}", text) for n, text in enumerate(p.read_text(encoding="utf-8").splitlines(), 1)]
            except (OSError, UnicodeDecodeError):
                pass
    return lines


def environment_file():
    return git("config", "--get", "--type=path", "gbase.conventions", check=False)  # --type=path expands a leading ~


def environment_text():
    """(the environment file's path, its text; None when it is set but can't be read). ('', '') when none is set."""
    conv = environment_file()
    if not conv:
        return "", ""
    try:
        return conv, Path(conv).expanduser().read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return conv, None


def preview_setting():
    """(the environment file's path when it asks for a preview before the PR, else ''; the path when it is set but unreadable)."""
    conv, text = environment_text()
    if text is None:
        return "", conv
    return (conv if re.search(PREVIEW_SETTING, text, re.I | re.M) else ""), ""


def listed(text, key):
    """The items of a `<key>: a, b` line, its backticks, quotes, and (notes) dropped; [] when there is none or it says none."""
    m = re.search(LIST_SETTING.format(key=key), text, re.I | re.M)
    value = re.sub(r"\([^)]*\)", "", m.group(1)) if m else ""
    items = [i.strip(" `'\"*_.") for i in value.split(",")]
    items = [i for i in items if i]
    return [] if [i.lower() for i in items] in ([], ["none"], ["off"], ["-"], ["없음"]) else items


def review_policy():
    """What the environment file asks of every PR here (review-policy.md): {} when it is unset, unreadable, or holds none of it.
    Keys: reviewers, labels (lists), bad (items that are not a login or org/team), signoff (bool), size (int), size_ask (bool)."""
    conv, text = environment_text()
    if not text:
        return {}
    policy = {}
    items = listed(text, "reviewers")
    people = [r for item in items for r in item.split()]
    bad = [r for r in people if not re.fullmatch("@?" + REVIEWER, r)]
    # words of a sentence each look like a login ("CODEOWNERS assigns them", "@alice and @bob"): a list item is one word,
    # or every word of it names someone with @ or /
    bad = bad or [i for i in items if len(i.split()) > 1 and not all(re.match(r"@|\S*/", w) for w in i.split())]
    if bad:  # prose ("CODEOWNERS가 배정"), not a list: asking GitHub for it would fail after the push
        policy["bad"] = bad
    elif people:
        policy["reviewers"] = [r.lstrip("@") for r in people]
    labels = listed(text, "labels")
    prose = [l for l in labels if len(l.split()) > 3]  # a label is a name of a word or three, not "set by the triage bot"
    if prose:
        policy["bad_labels"] = prose
    elif labels:
        policy["labels"] = labels
    if re.search(SIGNOFF_SETTING, text, re.I | re.M):
        policy["signoff"] = True
    size = re.search(SIZE_SETTING, text, re.I | re.M)
    limit = int(size.group(1).replace(",", "")) if size else 0
    if limit:
        policy["size"], policy["size_ask"] = limit, bool(size.group(2))
    elif not size and re.search(SIZE_LINE, text, re.I | re.M):
        policy["size_bad"] = True
    return {"file": conv, **policy} if policy else {}


def policy_line(policy):
    parts = [f"{k} {', '.join(policy[k])}" for k in ("reviewers", "labels") if policy.get(k)]
    if policy.get("signoff"):
        parts.append("sign-off on")
    if policy.get("size"):
        parts.append(f"PR size {policy['size']} lines" + (", ask" if policy["size_ask"] else ""))
    return f"review policy: {' · '.join(parts)} — from {policy['file']}; read {POLICY_DOC} before the first commit" if parts else None


def gpgsign():
    return git("config", "--type=bool", "--get", "commit.gpgsign", check=False) == "true"


def diff_size(base, entries=()):
    """Lines added plus removed between the base and the tree (untracked files counted whole); binary files count 0."""
    total = 0
    for row in git("diff", "--numstat", base).splitlines():
        added, removed = row.split("\t")[:2]
        total += int(added) + int(removed) if added.isdigit() and removed.isdigit() else 0
    for code, path in entries:
        if code == "??":
            try:
                total += len(Path(path).read_text(encoding="utf-8").splitlines())
            except (OSError, UnicodeDecodeError):
                pass
    return total


def unpushed(base, *flags):
    """Commits of base..HEAD no remote has: the only ones a sign-off or signature can still be added to without a force-push."""
    return [c for c in git("rev-list", "--reverse", *flags, f"{base}..HEAD", "--not", "--remotes").split("\n") if c] if base else []


def rewrite_hint(command, first):
    """How to fix the commits from `first` on, or, with a merge among them, why not by a rebase: one would flatten it and
    write the commits it brought in again, base commits included. A merge below `first` isn't rewritten, so it doesn't count."""
    merges = [c for c in git("rev-list", "--merges", f"{first}^..HEAD", check=False).split("\n") if c]
    if merges:
        return (f"a merge commit ({merges[0][:7]}) is among them, so no rebase: redo the branch's own commits on the base without it "
                "or ask the person (review-policy.md)")
    return f"`{command} {first[:7]}^` rewrites only these unpushed commits (review-policy.md)"


def commit_problems(policy, base):
    """Error lines for unpushed commits the policy or `commit.gpgsign` wants and they lack."""
    commits, errors = unpushed(base, "--no-merges"), []  # a merge commit needs no trailer: DCO checks skip it
    if policy.get("signoff"):
        # DCO checks the author's own sign-off, not any trailer
        missing = [c for c in commits if not re.search(r"^Signed-off-by: " + re.escape(git("log", "-1", "--format=%an <%ae>", c)) + r"\s*$",
                                                      git("log", "-1", "--format=%B", c), re.M)]
        if missing:
            errors.append(f"{policy['file']} says \"commit sign-off: on\" and {len(missing)} commit(s) have no `Signed-off-by:` trailer: "
                          + ", ".join(c[:7] for c in missing[:10])
                          + " — add it: " + rewrite_hint("git rebase --signoff", missing[0])
                          + ("; a commit someone else wrote needs its author's own sign-off, which only they can give: ask them"
                             if any(git("log", "-1", "--format=%ae", c) != git("log", "-1", "--format=%ce", c) for c in missing) else ""))
    if gpgsign():
        # the header, not %G?: an SSH signature reads as N when no gpg.ssh.allowedSignersFile is set
        # a merge commit too: branch protection that requires signed commits checks every commit the push brings
        unsigned = [c for c in unpushed(base) if not re.search(r"^gpgsig(-sha256)? ", git("cat-file", "commit", c), re.M)]
        if unsigned:
            errors.append(f"commit.gpgsign is on and {len(unsigned)} commit(s) carry no signature: " + ", ".join(c[:7] for c in unsigned[:10])
                          + " — signing failed or was skipped. Never `--no-gpg-sign`: say what failed, fix the signing setup, then re-sign them: "
                          + rewrite_hint("git rebase --exec 'git commit --amend --no-edit -S'", unsigned[0]))
    return errors


def gbase_dir():
    return Path(git("rev-parse", "--absolute-git-dir")) / "gbase"


def preview_file(branch):
    """Where the preview a person reads is kept: outside every repo and git dir, so it outlives a worktree. Named by
    the repo's main checkout (with a hash of its path: two repos may share a folder name) and the branch."""
    home = Path(os.environ.get("GBASE_HOME") or "~/.gbase").expanduser()
    common = Path(git("rev-parse", "--git-common-dir")).resolve()  # cwd is the toplevel (main())
    key = hashlib.sha1(f"{common}\n{branch}".encode()).hexdigest()[:6]
    return home / "previews" / f"{common.parent.name}-{re.sub(r'[^A-Za-z0-9._-]+', '-', branch)}-{key}.md"


def draft_digest(path):
    """A hash of the PR draft that survives the one edit made between the preview and the PR: uploaded screenshots
    replace their local paths, and `ship-prep assets` prints its own label with each. None when the draft can't be read."""
    try:
        text = Path(path).read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return None
    return hashlib.sha256(re.sub(r"!\[[^\]]*\]\([^)\n]*\)", "![]()", text).encode()).hexdigest()


def recorded_preview(branch):
    """(state file, state) of the preview `ship-prep preview --write` recorded for this branch, or (None, None). The
    file is named by the previewed commit's sha, so a session that only knows HEAD can tell whether HEAD was shown."""
    for path in sorted(gbase_dir().glob("preview-*.json")):
        try:
            state = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if isinstance(state, dict) and state.get("branch") == branch and state.get("head"):
            return path, state
    return None, None


def forget_preview(branch):
    path, _ = recorded_preview(branch)
    while path:  # an interrupted run may have left more than one
        path.unlink()
        path, _ = recorded_preview(branch)


def changed_since(state, entries, draft=None):
    """What differs from what the person was shown; [] means a PR opened now is the one they read. The one rule
    `start` and `open` both use: the commit, the tree (but for what was left out or untracked then), the draft,
    and that the preview file is still there."""
    shown, head = state["head"], git("rev-parse", "HEAD")
    changed = []
    if shown != head:
        if git_ok("cat-file", "-e", f"{shown}^{{commit}}"):
            changed += [p for p in git("diff", "--name-only", shown, head).split("\n") if p] or [f"the commit itself (@{shown[:7]} → @{head[:7]})"]
        else:
            changed.append(f"the previewed commit @{shown[:7]} is gone")
    known = set(state.get("left_out") or []) | set(state.get("untracked") or [])
    changed += [path for _, path in entries if path not in known and path not in changed]
    if draft_digest(draft or state.get("draft") or "") != state.get("draft_digest"):
        changed.append(f"the PR draft ({draft or state.get('draft')})")
    if not Path(state.get("preview") or "").is_file():
        changed.append("the preview file is missing")
    return changed


def preview_line(branch, entries):
    """(state, line) `start` prints about the preview: (None, None) when neither the setting nor a recorded preview asks for one."""
    _, state = recorded_preview(branch)
    if state:
        shown, draft, file = state["head"], state.get("draft"), state.get("preview")
        changed = changed_since(state, entries)
        if not changed:
            return "prepared", (f"preview: prepared — {branch} @{shown[:7]} is what {file} describes (draft {draft}) and nothing changed since: "
                                f"run no review or check again, show that preview again and ask (\"Asking\" in {PREVIEW_DOC})")
        return "changed", (f"preview: changed — since the preview of @{shown[:7]}: {', '.join(changed[:20])}; re-check only these, commit them, "
                           f"update the draft {draft}, and run `ship-prep preview` again (\"After a change\" in {PREVIEW_DOC})")
    conv, _ = preview_setting()
    if conv:
        return "on", f'preview: on — {conv} says "before the PR: preview": push nothing and open no PR; read {PREVIEW_DOC} before the first commit'
    return None, None


def write_back_line(already_open=False):
    conv = environment_file()
    if conv:
        print(f"environment: the PR is open — write back to the ticket only what {conv} marks `on` "
              f"(\"Shipping it\" in {ENVIRONMENT_DOC}); no ticket, nothing to write"
              + ("; it was already open, so read the ticket first and skip a write it already shows" if already_open else ""))


def cmd_start(args):
    local = "--local" in args
    out, ask = [], []
    if not git_ok("rev-parse", "--verify", "-q", "HEAD"):
        raise Stop(1, "error: no commits yet — make the first commit by hand")
    notes = unwrap_pause()
    for note in notes:
        out += ["pause note (use it for the PR's Why):"] + [f"  {l}" for l in note.splitlines() if l.strip()]
    default, base = default_base()
    branch = git("branch", "--show-current") or "(detached)"
    entries = status_paths()
    ahead = int(git("rev-list", "--count", f"{base}..HEAD")) if base else 0
    committed = [p for p in git("diff", "--name-only", f"{base}...HEAD").split("\n") if p] if base and ahead else []
    paths = sorted({p for _, p in entries} | set(committed))
    if not entries and not ahead:
        raise Stop(3, "nothing to ship: clean tree and no commits ahead of the base")

    out.append(f"branch: {branch} (default {default or 'unknown'}; base {base or 'unknown'}; {ahead} commits ahead)")
    if entries:
        ref, stat = backup()
        out.append(f"backup: {ref} — {stat}")
        out.append(f"  restore: git restore --source={ref} --worktree -- .   remove: git update-ref -d {ref}  (`gbase-run gc` prunes it after 14 days)")
        out.append(f"changed: {len(entries)} files in the tree" + (f", {len(committed)} already committed" if committed else ""))
        out += [f"  {code} {path}" for code, path in entries[:60]]
        if len(entries) > 60:
            out.append(f"  … {len(entries) - 60} more (git status)")
    else:
        out.append(f"changed: tree clean — {ahead} commits ahead already hold the change; no commit step")

    # unpushed commits ship too: scan what they added, not only the tree
    hits = secret_hits(sorted({p for _, p in entries} | set(committed)), added_lines(entries, f"{base}" if committed else "HEAD"))
    for where, kind in hits[:20]:
        ask.append(f"ask: secret? {where} — {kind}. Never commit it; leave it out and say so.")

    remotes = git("remote").split()
    open_pr = None
    if not local and remotes:
        view = run(["gh", "pr", "view", "--json", "number,url,state"], check=False)
        if view.returncode == 0 and json.loads(view.stdout).get("state") == "OPEN":
            open_pr = json.loads(view.stdout)
    if branch == "(detached)":
        ask.append("ask: detached HEAD — which branch should carry this change?")
    elif branch == default:
        out.append("branch plan: on the default branch — create one, named by the repo's rule (conventions.md); "
                   "with no rule, `feat/` `fix/` `refactor/` `docs/` `chore/` + slug")
    elif open_pr:
        out.append(f"branch plan: commit here; pushing updates the open PR {open_pr['url']}")
    elif ahead and entries and not local and not recorded_preview(branch)[1]:
        ask.append(f"ask: {branch} already has {ahead} commits of its own and no open PR — new branch off {default}, or keep committing here?")
    else:
        out.append("branch plan: commit on this branch")
    if not local and branch not in (default, "(detached)") and not open_pr \
            and git_ok("rev-parse", "--verify", "-q", f"origin/{branch}") and not git_ok("merge-base", "--is-ancestor", f"origin/{branch}", "HEAD"):
        ask.append(f"ask: origin/{branch} already exists with commits this branch doesn't have, and has no open PR — another name, or build on it?")
    if not local:
        if not remotes:
            ask.append("ask: no remote — where should the branch be pushed?")
        elif "origin" not in remotes:
            ask.append(f"ask: no `origin` among remotes ({', '.join(remotes)}) — which one? (then `open --remote <name>`)")

    conv = environment_file()
    files = [f for f in git("ls-files").split("\n") if re.search(CONVENTION_FILES, f, re.I)]
    if conv or files:
        out.append("conventions — read before naming the branch, commits, or PR: " + ", ".join(([conv] if conv else []) + files))
    else:
        out.append("conventions: none written down — follow recent history, then the gbase defaults (conventions.md)")
    if conv:
        out.append(f"environment: {conv} — when this change came from a ticket (the request or the branch names one), "
                   f"read \"Shipping it\" in {ENVIRONMENT_DOC} before the PR draft")
    policy = review_policy()
    if line := policy_line(policy):
        out.append(line)
    if policy.get("size_bad"):
        out.append(f"note: the `PR size:` line of {conv} holds no number of lines this reads (`PR size: 400 lines`) — no size is checked; "
                   "say so in the report")
    if policy.get("bad_labels"):
        out.append(f"note: the `Labels:` line of {conv} reads as a sentence ({policy['bad_labels'][0]}), not label names — no label is added; "
                   "say so in the report")
    if policy.get("bad"):
        out.append(f"note: the `Reviewers:` line of {conv} is not a list of logins or org/teams ({', '.join(policy['bad'][:5])}) — "
                   "no reviewer is requested; say so in the report")
    if local:  # the caller opens the PR, so it is the one that asks for these: they go in the report as they are
        out += [f"{k}: {', '.join(policy[k])}" for k in ("reviewers", "labels") if policy.get(k)]
    if policy.get("size") and base:
        size = diff_size(git("merge-base", base, "HEAD", check=False) or base, entries)  # base's own later commits aren't this change
        if size > policy["size"]:
            out.append(f"size: {size} lines, over the {policy['size']} of PR size — the draft's Review focus item 1 proposes the split (review-policy.md)")
            if policy["size_ask"]:
                ask.append(f"ask: the change is {size} lines, over the {policy['size']} the environment file sets — split it, or open it as one PR?")
    if gpgsign():
        out.append("signing: commit.gpgsign is on — a commit that fails to sign stops the run; never `--no-gpg-sign`")
    out.append(compat_line(paths, base or "<base>"))
    out.append(risk_hint(paths))
    state = preview = None
    if open_pr:
        forget_preview(branch)
    elif not local and branch != "(detached)":
        state, preview = preview_line(branch, entries)
        unreadable = preview_setting()[1]
        if unreadable:
            out.append(f"note: the environment file {unreadable} can't be read — its conventions are not applied, and `ship-prep open` "
                       "will refuse, because whether its owner reads a preview before the PR is unknown; say so in the report")
    if preview:
        out.append(preview)
    out += ask
    if ask:
        out.append("next: settle every `ask:` line first (headless: headless.md), then commit")
    elif state == "prepared":
        out.append("next: show the preview again and ask; `ship-prep open` takes it from there")
    else:
        steps = ("group the files into commits, then " if entries else "") + "write the PR draft"
        out.append(f"next: {steps}" + (", then `ship-prep preview <draft>` instead of `open`" if preview else ""))
    print("\n".join(out))
    return 2 if ask else 0


def read_draft(path):
    try:
        return Path(path).read_text(encoding="utf-8").split("\n")
    except OSError as e:
        raise Stop(1, f"error: can't read the draft — {e}")


def unverified_lines(body):
    """Lines a person has to confirm: the draft's Evidence lines, and the run's evidence file when the caller set one."""
    section = re.search(r"^## Evidence\s*$(.*?)(?=^## |\Z)", body, re.M | re.S)
    found = [l.strip() for l in (section.group(1) if section else "").splitlines() if re.search(UNVERIFIED, l)]
    path = os.environ.get("AGENT_EVIDENCE_FILE")
    try:
        records = Path(path).read_text(encoding="utf-8").splitlines() if path else []
    except OSError:
        records = []
    latest = {}  # the file is append-only: a later line for the same check (a rerun, a resumed session) replaces the earlier one
    for raw in records:
        try:
            e = json.loads(raw)
        except ValueError:
            continue
        if isinstance(e, dict):
            latest[(str(e.get("step")), str(e.get("command")))] = e  # str: a hand-written line may hold a list
    for e in latest.values():
        if e.get("step") == "behavior" and e.get("result") == "open":
            found.append(f"evidence file: behavior open — {e.get('command')}")
        if "differs:" in str(e.get("input") or ""):
            found.append(f"evidence file: {e.get('command')} — {e.get('input')}")
    return found


def draft_problems(lines, local=False, size=None):
    """Mechanical rules of branch-pr's body; `size` is (lines changed, the PR size limit) when the review policy sets one.
    Returns (errors, warnings)."""
    errors, warnings = [], []
    if not lines or not lines[0].strip():
        errors.append("line 1 must be the PR title")
    if len(lines) < 3 or lines[1].strip():
        errors.append("line 2 must be empty, the body starts on line 3")
    body = "\n".join(lines[2:])
    for heading in ("## Review focus", "## Evidence"):
        if not re.search(rf"^{re.escape(heading)}\s*$", body, re.M):
            errors.append(f"missing `{heading}` (a repo template gets it added too)")
    alert = r"^> \[!(\w+)\]"
    alerts = re.findall(alert, body, re.M)
    if len(alerts) > 1:
        errors.append(f"{len(alerts)} alert boxes — only Review focus has one")
    focus = re.search(r"^## Review focus\s*$(.*?)(?=^## |\Z)", body, re.M | re.S)
    if focus:
        if not re.search(alert, focus.group(1), re.M):
            errors.append("Review focus needs its `> [!IMPORTANT]` box, or `> [!NOTE]` when nothing needs a person")
        items = re.findall(r"^> \d+\. ", focus.group(1), re.M)
        if len(items) > MAX_FOCUS_ITEMS:
            errors.append(f"{len(items)} Review focus items (at most {MAX_FOCUS_ITEMS}) — the PR should be split; say so as item 1")
    if size and size[0] > size[1] and not (focus and re.search(SIZE_ITEM, focus.group(1), re.M)):
        errors.append(f"the change is {size[0]} lines, over the {size[1]} of PR size — Review focus item 1 proposes how to split it "
                      "and ends with `(크기)` (review-policy.md)")
    unverified = unverified_lines(body)
    if unverified and not (focus and re.search(CONFIRM_ITEM, focus.group(1), re.M)):
        errors.append(f"{len(unverified)} unverified line(s) (`behavior: skip`, `differs:`) but Review focus has no `(확인)` item — "
                      "add an item that says, for each line, what a person checks and where: " + " / ".join(unverified[:3]))
    if any(re.match(r"- \[x\]", l, re.I) and "behavior: skip" in l for l in unverified):
        errors.append("a skipped behavior check is not a checked box — write it `- [ ] behavior: skip — <reason>`")
    if not local:
        for target in re.findall(r"!\[[^\]]*\]\(([^)\s]+)", body):
            if not re.match(r"https?://", target):
                errors.append(f"image `{target}` is a local path a reviewer can't open — upload it (`ship-prep assets`)")
    if re.search(r"<(exactly one sentence|the question|PR title|one numbered|before → after first|only what a reviewer)", body):
        errors.append("a template placeholder is still in the body")
    lead = body.split("## Change outline")[0].count("\n")
    if lead > LEAD_LINES:
        warnings.append(f"{lead} lines before Change outline — it should fit on one screen")
    return errors, warnings


def size_limit(policy, base):
    return (diff_size(f"{base}...HEAD"), policy["size"]) if policy.get("size") and base else None


def cmd_check(args):
    local = "--local" in args
    paths = [a for a in args if not a.startswith("--")]
    if len(paths) != 1:
        raise Stop(1, "usage: ship-prep check <draft> [--local]")
    policy, base = review_policy(), default_base()[1]
    errors, warnings = draft_problems(read_draft(paths[0]), local, size_limit(policy, base))
    errors += commit_problems(policy, base)  # the one check a local run makes: its caller pushes what this passes
    out = [f"warn: {w}" for w in warnings] + [f"error: {e}" for e in errors]
    print("\n".join(out + (["next: fix the draft and run check again"] if errors else ["draft: ok"])))
    return 1 if errors else 0


def uncommitted(entries, args, what):
    """Tracked files with uncommitted changes stop a preview or a PR unless --partial says they were left out on purpose."""
    tracked = [path for code, path in entries if code != "??"]
    if tracked and "--partial" not in args:
        raise Stop(1, [f"error: uncommitted changes to tracked files — {what} without them: " + ", ".join(tracked[:10]),
                       "next: commit what belongs in the PR; if they were left out on purpose (a secret, unrelated WIP), rerun with --partial"])
    if tracked:
        print("note: left out on purpose (--partial) — say so in the report: " + ", ".join(tracked[:10]))


def cmd_preview(args):
    paths = [a for a in args if not a.startswith("--")]
    if len(paths) != 1:
        raise Stop(1, "usage: ship-prep preview <draft> [--partial] [--write [--reviewed] < preview text]")
    if "--reviewed" in args and "--write" not in args:
        raise Stop(1, "error: --reviewed goes with --write: it marks the commit that call records, and this call records nothing")
    text = sys.stdin.read() if "--write" in args else None
    if text is not None and not text.strip():
        raise Stop(1, "error: --write saves the preview text it reads on stdin, and stdin was empty")
    lines = read_draft(paths[0])
    policy = review_policy()
    default, base = default_base()
    errors = draft_problems(lines, local=True, size=size_limit(policy, base))[0] + commit_problems(policy, base)
    if errors:
        raise Stop(1, [f"error: {e}" for e in errors] + ["next: fix the draft and run preview again"])
    entries = status_paths()
    uncommitted(entries, args, "the preview would describe a PR")
    branch = git("branch", "--show-current")
    if not base:
        raise Stop(1, ["error: can't tell which branch the PR goes to — no origin/HEAD, main, or master here",
                       "next: `git remote set-head origin -a` (or fetch the default branch), then run preview again"])
    if not branch or branch == default:
        raise Stop(1, f"error: on {branch or 'a detached HEAD'} — the change needs its own branch before it is previewed")
    ahead = int(git("rev-list", "--count", f"{base}..HEAD"))
    if not ahead:
        raise Stop(3, "nothing to ship: no commits ahead of the base — commit the change first")
    head = git("rev-parse", "HEAD")
    file = preview_file(branch)
    on_remote = git_ok("merge-base", "--is-ancestor", "HEAD", f"origin/{branch}")  # pushed by hand: only the PR is held back
    print(f"ship: local {branch} @{head[:7]} — {ahead} commits, " + (f"already on origin/{branch}, no PR" if on_remote else "not pushed"))
    print(f"PR 본문 초안: {paths[0]}")
    print(f"preview: {file}")
    if text is not None:
        # recorded only now: until the text exists nobody can have read it, and `open` goes by this record
        folder = gbase_dir()
        folder.mkdir(parents=True, exist_ok=True)
        file.parent.mkdir(parents=True, exist_ok=True)
        file.write_text(text if text.endswith("\n") else text + "\n", encoding="utf-8")
        forget_preview(branch)
        state = {"reviewed": "--reviewed" in args, "preview": str(file), "branch": branch, "head": head, "draft": paths[0],
                 "draft_digest": draft_digest(paths[0]),
                 "left_out": [path for code, path in entries if code != "??"], "untracked": [path for code, path in entries if code == "??"]}
        (folder / f"preview-{head}.json").write_text(json.dumps(state, ensure_ascii=False) + "\n", encoding="utf-8")
        print(f"saved: {len(text.splitlines())} lines, and @{head[:7]} recorded as the commit that was shown — print the same text "
              "in the reply, then ask; headless, report the three lines above and stop")
        return 0
    print(f"title: {lines[0].strip()}")
    print(f"commits ({base}..HEAD):")
    print("\n".join(f"  {l}" for l in git("log", "--reverse", "--format=%h %s", f"{base}..HEAD").splitlines()))
    print(f"files ({base}...HEAD, added/removed lines):")
    for row in git("diff", "--numstat", f"{base}...HEAD").splitlines():
        added, removed, path = row.split("\t", 2)
        print(f"  +{added} -{removed}  {path}")
    print(f"next: nothing is recorded yet. Write the preview (the format is in {PREVIEW_DOC}) and run this command again with "
          "`--write` and the text on stdin (`--reviewed` too when gbase:go's review and checks ran for this commit)")
    return 0


def cmd_open(args):
    args = list(args)
    remote = "origin"
    if "--remote" in args:
        i = args.index("--remote")
        if i + 1 >= len(args):
            raise Stop(1, "error: --remote needs a name")
        remote = args[i + 1]
        del args[i:i + 2]
    draft = "--draft" in args
    paths = [a for a in args if not a.startswith("--")]
    if len(paths) != 1:
        raise Stop(1, "usage: ship-prep open <draft> [--draft] [--partial] [--remote <name>] [--no-preview]")
    lines = read_draft(paths[0])
    policy = review_policy()
    default, base = default_base()
    errors = draft_problems(lines, size=size_limit(policy, base))[0] + commit_problems(policy, base)
    if errors:
        raise Stop(1, [f"error: {e}" for e in errors] + ["next: fix what it says and run open again; nothing was pushed"])
    entries = status_paths()
    uncommitted(entries, args, "the PR would ship")
    if entries:  # untracked leftovers (caches, scratch files) don't block; deleting them to get past a gate would be worse
        print("note: untracked files stay out of the PR — say so in the report: " + ", ".join(path for _, path in entries[:10]))
    branch = git("branch", "--show-current")
    if not branch or branch == default:
        raise Stop(1, f"error: on {branch or 'a detached HEAD'} — a PR needs its own branch")
    preview_gate(branch, entries, paths[0], args)
    push = run(["git", "push", "-u", remote, "HEAD"], check=False)
    if push.returncode:
        raise Stop(1, ["error: push failed — not retried, nothing forced", push.stderr.strip(), "next: git status; say what blocked the push"])
    print(f"pushed: {branch} @{git('rev-parse', '--short', 'HEAD')}")
    view = run(["gh", "pr", "view", "--json", "url,state"], check=False)
    existing = json.loads(view.stdout) if view.returncode == 0 else {}
    if existing.get("state") == "OPEN":
        print("note: the PR was already open — the push updated it; its body is unchanged (`gh pr edit --body-file` to change it)")
        print(f"pr: {existing['url']}")
        forget_preview(branch)
        write_back_line(already_open=True)
        return 0
    base_args = ["gh", "pr", "create", "--title", lines[0].strip(), "--body-file", "-"] + (["--draft"] if draft else [])
    asked = [a for k, flag in (("reviewers", "--reviewer"), ("labels", "--label")) for v in policy.get(k, []) for a in (flag, v)]
    create = run(base_args + asked, check=False, input="\n".join(lines[2:]))
    if create.returncode and asked:  # a login that left, the author, a label not made yet: the PR opens without them, and the report says so
        print(f"note: GitHub refused the reviewers or labels of {policy['file']} ({(create.stderr.strip().splitlines() or ['no reason given'])[-1]}) — "
              "the PR opens without what it refused; say so in the report")
        made = run(["gh", "pr", "view", "--json", "url,state"], check=False)  # gh makes the PR before it asks for reviewers
        if made.returncode == 0 and json.loads(made.stdout).get("state") == "OPEN":
            create = subprocess.CompletedProcess(base_args, 0, json.loads(made.stdout)["url"], "")
        else:
            # it failed before making the PR: drop one kind at a time, so a missing label doesn't cost the reviewers too
            parts = [[a for i in range(0, len(asked), 2) if asked[i] == flag for a in asked[i:i + 2]] for flag in ("--reviewer", "--label")]
            for extra in [p for p in parts if p and p != asked] + [[]]:
                create = run(base_args + extra, check=False, input="\n".join(lines[2:]))
                if not create.returncode:
                    break
    elif asked:
        print("requested: " + " · ".join(f"{k} {', '.join(policy[k])}" for k in ("reviewers", "labels") if policy.get(k)))
    if create.returncode:
        raise Stop(1, ["error: gh pr create failed (the branch is pushed)", create.stderr.strip()])
    url = next((l.strip() for l in reversed(create.stdout.splitlines()) if l.strip().startswith("http")), create.stdout.strip())
    print(f"pr: {url}")
    forget_preview(branch)
    write_back_line()
    print("next: put the `pr:` line in the final report at column 0")
    return 0


def preview_gate(branch, entries, draft, args):
    """Where a preview is asked for (the environment file's line, or one already recorded for this branch), the PR
    opens only as the person was shown it. The request can waive that (--no-preview); an open PR already has."""
    if "--no-preview" in args:
        return
    conv, unreadable = preview_setting()
    _, state = recorded_preview(branch)
    if not (conv or unreadable or state):
        return
    changed = changed_since(state, entries, draft) if state else None
    if state and not changed:
        return
    view = run(["gh", "pr", "view", "--json", "state"], check=False)
    if view.returncode == 0 and json.loads(view.stdout).get("state") == "OPEN":
        return
    if state:
        raise Stop(1, [f"error: what would open is not what the preview of @{state['head'][:7]} showed — changed since: "
                       f"{', '.join(changed[:10])}; nothing pushed",
                       f"next: run `ship-prep preview <draft>` again and show the new preview before opening ({PREVIEW_DOC})"])
    if unreadable:
        raise Stop(1, [f"error: the environment file {unreadable} can't be read, so whether its owner reads a preview before the PR "
                       "is unknown — nothing pushed",
                       "next: fix the path (`git config gbase.conventions`) or the file's encoding (UTF-8) and run open again; "
                       "add --no-preview only when the request itself asked for the PR or the merge in words"])
    raise Stop(1, [f'error: {conv} says "before the PR: preview" and no preview was recorded — nothing pushed',
                   f"next: read {PREVIEW_DOC}: run `ship-prep preview <draft>`, show the preview, and ask; "
                   "add --no-preview only when the request itself asked for the PR or the merge in words"])


def cmd_assets(args):
    files = [a for a in args if not a.startswith("--")]
    if not files:
        raise Stop(1, "usage: ship-prep assets <file>...")
    branch = git("branch", "--show-current")
    missing = [f for f in files if not Path(f).expanduser().is_file()]
    if missing or not branch:
        raise Stop(1, f"error: no such file: {', '.join(missing)}" if missing else "error: detached HEAD — assets are filed under the branch name")
    repo = run(["gh", "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"]).stdout.strip()
    if run(["gh", "api", f"repos/{repo}/git/ref/heads/gbase-assets"], check=False).returncode:
        root = git("rev-list", "--max-parents=0", "HEAD").split("\n")[-1]
        run(["gh", "api", f"repos/{repo}/git/refs", "-f", "ref=refs/heads/gbase-assets", "-f", f"sha={root}"])
    for f in files:
        p = Path(f).expanduser()
        dest = f"{branch}/{p.name}"
        payload = {"branch": "gbase-assets", "message": f"assets: {dest}", "content": base64.b64encode(p.read_bytes()).decode()}
        old = run(["gh", "api", f"repos/{repo}/contents/{dest}?ref=gbase-assets", "-q", ".sha"], check=False)
        if old.returncode == 0 and old.stdout.strip():
            payload["sha"] = old.stdout.strip()  # replacing an image of the same name
        # body via stdin: a screenshot's base64 can exceed the argument-length limit
        run(["gh", "api", "-X", "PUT", f"repos/{repo}/contents/{dest}", "--input", "-"], input=json.dumps(payload))
        print(f"![{p.stem}](https://github.com/{repo}/raw/gbase-assets/{dest})")
    return 0


COMMANDS = {"start": cmd_start, "check": cmd_check, "preview": cmd_preview, "open": cmd_open, "assets": cmd_assets}


def main(argv):
    if not argv or argv[0] not in COMMANDS:
        print(__doc__.strip())
        return 1
    try:
        # git prints paths from the repo root and scopes `ls-files` to the cwd: from a subdirectory both would go quietly wrong
        args = [a if a.startswith("--") or i and argv[i] == "--remote" else os.path.abspath(os.path.expanduser(a)) for i, a in enumerate(argv[1:])]
        os.chdir(git("rev-parse", "--show-toplevel"))
        return COMMANDS[argv[0]](args)
    except Stop as s:
        print("\n".join(l for l in s.lines if l))
        return s.code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
