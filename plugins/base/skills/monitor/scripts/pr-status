#!/usr/bin/env python3
"""The PR state gbase:monitor acts on: one `gh` query, classified, with what to do next.

  pr-status [--pr N] [--start] [--merge] [--verified-locally]   one snapshot
  pr-status wait [--timeout 270] [--interval 30] [--handled] [...]   --until-settled: poll until something needs action, then the snapshot
  pr-status watch [--interval 30] [...]                          for the Monitor tool: one line per state change, until merge/close
  pr-status patch [--base <ref>] [--was <rev>]                   after a rebase or a base merge, before the push: is the change still the one that was verified?
  pr-status drafted [--pr N] < drafts.jsonl                      replies held as drafts: record them (one JSON object per line), print the table to show

  --start             begin a watch: forget earlier heads and timers for this PR
  --merge             also judge the merge gate and print the merge command
  --verified-locally  the caller's local checks passed this run (lets a merge past checks that never started)
  --handled           wait only: what was open at the first poll is already dealt with locally; return on something new or when all concludes
  --hold-replies      post nothing on the PR this watch: replies are drafted for the user (also the environment file's `review replies: draft`)
  --post-replies      post replies this watch even though the environment file says to draft them

  --base              patch only: the ref the branch was rebased onto (default: the PR's base on origin, else origin/HEAD)
  --was               patch only: the head that was verified (default: the pushed head, @{upstream})

A `drafted` line: {"id": <the number in [thread <id>]>, "verdict": "fixed|declined|answered|undecided|out-of-scope",
"reply": "<the reply as it would be posted>", "commit": "<the fix, for fixed>", "why": "<reason and file:line, for declined>",
"gist": "<the comment in one line>"}. With nothing on stdin it prints the table of what is held.

`next:` lines are in the order to handle them. A `settle:` line is the verdict to report when nothing more can be fixed.
State (first-seen time per head, links already shown) is kept in <git-dir>/gbase/pr-status-<n>.json; held reply drafts in
$GBASE_HOME/replies/ (default ~/.gbase/replies/), outside every repo, so a later watch or another worktree doesn't draft them again.
"""
import calendar
import contextlib
import fcntl
import hashlib
import json
import os
import re
import subprocess
import sys
import time
import urllib.parse
from pathlib import Path

GIVE_UP_SECONDS = 30 * 60   # into the wait on one head
MAX_PUSHED_HEADS = 3        # fixes pushed in one watch before the approach itself is the problem
CHECK_GRACE_SECONDS = 120   # checks can take a minute to register after a push
# a change to these alone re-verifies nothing; `license.py` and `page.mdx` are code
WORDING_FILES = (r".*\.(md|rst|adoc)", r"(LICENSE|CHANGELOG|NOTICE)(\.txt)?")
TRUSTED_ASSOCIATIONS = {"OWNER", "MEMBER", "COLLABORATOR"}
# GitHub's own annotation for a job the account couldn't start; a test named "billing" must not match
NOT_STARTED = re.compile(r"not started because|recent account payments have failed|spending limit needs to be increased", re.I)
NOT_A_TRY_LINK = re.compile(r"^https?://docs\.|badge|\.(svg|png|jpe?g|gif)(\?|$)", re.I)
PUSH_TRIGGER = re.compile(r"^\s*push:|^(on|'on'|\"on\"):\s*\[?[^\n#]*\bpush\b|^\s*-\s*push\s*$", re.M)
LINK_HOSTS = re.compile(
    r"https?://[^\s)\]>\"'|]*(?:expo\.dev|exp\.host|vercel\.app|netlify\.app|pages\.dev|web\.app|testflight\.apple\.com|"
    r"appdistribution\.firebase\.(?:dev|google\.com)|chromatic\.com|play\.google\.com/apps/(?:internaltest|testing))[^\s)\]>\"'|]*", re.I)

REPLIES_SETTING = r"^[\s>*_-]*`?review replies[`*_]*\s*[:：][\s`*_]*draft\b"
HELD_DOC = "references/held-replies.md"
VERDICTS = {"fixed": "고침", "declined": "거절", "answered": "답변", "undecided": "질문", "out-of-scope": "범위 밖"}

QUERY = """
query($owner:String!,$repo:String!,$number:Int!){repository(owner:$owner,name:$repo){
  pullRequest(number:$number){
    number url state isDraft mergeable mergeStateStatus reviewDecision baseRefName headRefName headRefOid
    commits(last:1){nodes{commit{author{user{login}} statusCheckRollup{contexts(first:100){nodes{__typename
      ... on CheckRun{name status conclusion startedAt detailsUrl databaseId isRequired(pullRequestNumber:$number) checkSuite{app{slug}}}
      ... on StatusContext{context state targetUrl isRequired(pullRequestNumber:$number)}}}}}}}
    reviewThreads(first:100){nodes{isResolved isOutdated path line comments(first:50){nodes{databaseId author{login __typename} authorAssociation body createdAt url}}}}
    reviews(last:50){nodes{databaseId author{login __typename} authorAssociation state body submittedAt commit{oid} url}}
    comments(last:50){nodes{databaseId author{login __typename} authorAssociation body createdAt updatedAt url}}
    reviewRequests(first:20){nodes{asCodeOwner requestedReviewer{__typename ... on Bot{login} ... on User{login} ... on Team{combinedSlug}}}}
  }
  pullRequests(states:MERGED,first:5,orderBy:{field:UPDATED_AT,direction:DESC}){nodes{
    reviews(first:30){nodes{author{login __typename}}}}}
}}"""


ANNOTATIONS = {}
REQUIRED_APPROVALS = {}


class GhError(Exception):
    pass


def sh(cmd, check=True, body_on_error=False):
    """`body_on_error`: a failed `gh api` that still printed a JSON body returns it (GraphQL's partial errors)."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True)
    except OSError as e:
        raise GhError(f"can't run {cmd[0]} — {e.strerror}")
    if body_on_error and p.returncode and p.stdout.lstrip().startswith("{"):
        return p.stdout.strip()
    if check and p.returncode:
        message = (p.stderr or p.stdout).strip()
        raise GhError(message.splitlines()[-1] if message else f"{cmd[0]} exited {p.returncode}")
    return p.stdout.strip()


# --- classification (pure) -------------------------------------------------

def epoch(iso):
    return calendar.timegm(time.strptime(iso[:19], "%Y-%m-%dT%H:%M:%S")) if iso else 0  # GitHub timestamps are UTC


def login(author):
    return (author or {}).get("login") or "ghost"


def is_bot(author):
    return (author or {}).get("__typename") == "Bot" or login(author).endswith("[bot]")


def bot_key(name):
    return re.sub(r"\[bot\]$", "", name or "").lower()


def check_kind(node, annotations=()):
    """passed / failed / pending / skipped / not-started (a job the account couldn't start: not a diff failure)."""
    if node.get("__typename") == "StatusContext":
        state = node.get("state")
        return {"SUCCESS": "passed", "PENDING": "pending", "EXPECTED": "pending"}.get(state, "failed")
    if node.get("status") != "COMPLETED":
        return "pending"
    conclusion = node.get("conclusion")
    if conclusion in ("SUCCESS", "NEUTRAL"):
        return "passed"
    if conclusion == "SKIPPED":
        return "skipped"
    if any(NOT_STARTED.search(a or "") for a in annotations):
        return "not-started"
    return "failed"


def first_line(body, width=110):
    line = next((l.strip() for l in (body or "").splitlines() if l.strip()), "")
    return line if len(line) <= width else line[: width - 1] + "…"


def normalize(data, me, annotations=lambda check_id: (), polls=(), required=lambda base: None):
    """GraphQL response -> the snapshot every decision below reads. `polls`: when earlier snapshots of this watch were taken."""
    repo = data["repository"]
    pr = repo["pullRequest"]
    commit = (pr["commits"]["nodes"] or [{}])[-1].get("commit", {})
    rollup = ((commit.get("statusCheckRollup") or {}).get("contexts") or {}).get("nodes") or []
    checks = []
    for n in rollup:
        run = n.get("__typename") != "StatusContext"
        notes = annotations(n["databaseId"]) if run and n.get("status") == "COMPLETED" and n.get("conclusion") not in ("SUCCESS", "NEUTRAL", "SKIPPED") and n.get("databaseId") else ()
        checks.append({"name": n.get("name") or n.get("context"), "kind": check_kind(n, notes), "required": bool(n.get("isRequired")),
                       "url": n.get("detailsUrl") or n.get("targetUrl") or "", "id": n.get("databaseId"),
                       "app": bot_key(((n.get("checkSuite") or {}).get("app") or {}).get("slug")), "started": epoch(n.get("startedAt"))})

    threads = pr["reviewThreads"]["nodes"] or []
    thread_comments = [c for t in threads for c in t["comments"]["nodes"]]
    reviews = pr["reviews"]["nodes"] or []
    comments = pr["comments"]["nodes"] or []
    # reviewers only: a bot that merely comments (a deploy preview, an issue link-back) is never waited on
    expected = set()
    merged_reviews = [x for m in repo.get("pullRequests", {}).get("nodes") or [] for x in m["reviews"]["nodes"]]
    for group in merged_reviews, thread_comments, reviews:
        expected |= {bot_key(login(x["author"])) for x in group if is_bot(x.get("author"))}
    requested = {bot_key(login(r["requestedReviewer"])) for r in pr["reviewRequests"]["nodes"]
                 if (r.get("requestedReviewer") or {}).get("__typename") == "Bot"}
    expected |= requested
    reviewers = []
    for r in pr["reviewRequests"]["nodes"]:
        who = r.get("requestedReviewer")  # null when the token can't read it (a team without read:org): still someone asked
        if who is None or who.get("__typename") in ("User", "Team"):
            name = (who or {}).get("login") or (who or {}).get("combinedSlug") or "읽을 수 없는 리뷰어"
            reviewers.append(name + (" (CODEOWNERS)" if r.get("asCodeOwner") else ""))
    expected.discard(bot_key(me))
    expected -= {"github-actions"}  # posts check summaries, reviews nothing

    def trusted(author, assoc):
        return assoc in TRUSTED_ASSOCIATIONS or (is_bot(author) and bot_key(login(author)) in expected)

    items = []
    for t in threads:
        cs = t["comments"]["nodes"]
        if t["isResolved"] or not cs or login(cs[-1]["author"]) == me:
            continue  # resolved, or already answered by us
        last = cs[-1]
        items.append({"type": "thread", "id": cs[0]["databaseId"], "last": last["databaseId"], "author": login(last["author"]), "assoc": last.get("authorAssociation"),
                      "bot": is_bot(last["author"]), "trusted": trusted(last["author"], last.get("authorAssociation")),
                      "where": f"{t.get('path')}:{t.get('line') or '?'}" + (" (outdated)" if t.get("isOutdated") else ""),
                      "quote": first_line(last["body"]), "url": last.get("url"), "suggestion": "```suggestion" in (last["body"] or "")})
    latest_review = {}
    for r in reviews:
        if r["state"] in ("APPROVED", "CHANGES_REQUESTED", "DISMISSED"):
            latest_review[login(r["author"])] = r
    for who, r in latest_review.items():
        if r["state"] == "CHANGES_REQUESTED" and who != me:
            items.append({"type": "changes-requested", "id": r["databaseId"], "last": r["databaseId"], "author": who, "assoc": r.get("authorAssociation"),
                          "bot": is_bot(r["author"]), "trusted": trusted(r["author"], r.get("authorAssociation")), "where": "review",
                          "quote": first_line(r["body"]) or "(no summary — see its inline comments)", "url": r.get("url"), "suggestion": False})
    mine = [epoch(c["createdAt"]) for c in comments if login(c["author"]) == me]
    answered_until = max(mine) if mine else 0
    # our comment answers what we had seen when we wrote it: a comment that arrived after the last snapshot before it is still open
    answered_until = max([t for t in polls if t < answered_until], default=answered_until)
    notes = []  # a bot's PR-level text is shown once, not waited on: it may be a preview link or a list of findings
    for c in comments:
        if is_bot(c["author"]) and login(c["author"]) != me:
            notes.append({"id": c["databaseId"], "author": login(c["author"]), "quote": first_line(c["body"]),
                          "at": c.get("updatedAt") or c["createdAt"], "url": c.get("url")})
    for r in reviews:
        if is_bot(r["author"]) and r["state"] == "COMMENTED" and (r["body"] or "").strip() and login(r["author"]) != me:
            notes.append({"id": r["databaseId"], "author": login(r["author"]), "quote": first_line(r["body"]), "at": r["submittedAt"], "url": r.get("url")})
    for c in comments:  # a person's PR-level comment is open until we comment after it
        if login(c["author"]) == me or is_bot(c["author"]) or epoch(c["createdAt"]) <= answered_until:
            continue
        items.append({"type": "comment", "id": c["databaseId"], "last": c["databaseId"], "author": login(c["author"]), "assoc": c.get("authorAssociation"), "bot": False,
                      "trusted": trusted(c["author"], c.get("authorAssociation")), "where": "conversation",
                      "quote": first_line(c["body"]), "url": c.get("url"), "suggestion": False})
    for r in reviews:
        if r["state"] == "COMMENTED" and (r["body"] or "").strip() and login(r["author"]) != me and not is_bot(r["author"]) \
                and epoch(r["submittedAt"]) > answered_until:
            items.append({"type": "review", "id": r["databaseId"], "last": r["databaseId"], "author": login(r["author"]), "assoc": r.get("authorAssociation"), "bot": False,
                          "trusted": trusted(r["author"], r.get("authorAssociation")), "where": "review",
                          "quote": first_line(r["body"]), "url": r.get("url"), "suggestion": False})

    head = pr["headRefOid"]
    starts = [c["started"] for c in checks if c["started"]]
    pushed = min(starts) if starts else None  # the first check on a head starts right after its push
    activity = {}

    def bump(author, when):
        if is_bot(author):
            key = bot_key(login(author))
            activity[key] = max(activity.get(key, 0), when)

    for r in reviews:  # a review of this head counts whenever it was written
        bump(r["author"], float("inf") if (r.get("commit") or {}).get("oid") == head else epoch(r["submittedAt"]))
    for c in comments:
        bump(c["author"], epoch(c.get("updatedAt") or c["createdAt"]))
    for c in thread_comments:
        bump(c["author"], epoch(c["createdAt"]))
    concluded_apps = {c["app"] for c in checks if c["app"] and c["kind"] != "pending"} - {c["app"] for c in checks if c["kind"] == "pending"}

    links = []
    sources = [(login(c["author"]), c["body"]) for c in comments if is_bot(c["author"])] + [(c["name"], c["url"]) for c in checks]
    for source, text in sources:
        for url in (u.rstrip(".,") for u in LINK_HOSTS.findall(text or "")):
            if url not in [l["url"] for l in links] and not NOT_A_TRY_LINK.search(url):
                links.append({"url": url, "source": source})

    return {"number": pr["number"], "url": pr["url"], "state": pr["state"], "draft": pr["isDraft"], "head": head,
            "mergeable": pr["mergeable"], "merge_state": pr["mergeStateStatus"], "review_decision": pr.get("reviewDecision"),
            "base": pr["baseRefName"], "branch": pr["headRefName"], "pushed": pushed, "notes": notes,
            "head_is_mine": login(((commit.get("author") or {}).get("user"))) == me,
            "checks": checks, "items": items, "expected": sorted(expected), "activity": activity,
            "concluded_apps": sorted(concluded_apps), "links": links, "reviewers": reviewers,
            "approvals": sum(1 for who, r in latest_review.items() if r["state"] == "APPROVED" and who != me),
            "required_approvals": required(pr["baseRefName"]) if pr.get("reviewDecision") == "REVIEW_REQUIRED" or pr["mergeStateStatus"] == "BLOCKED" else None,
            "my_comments": [c["body"] or "" for c in comments if login(c["author"]) == me]}


def waiting_bots(snap, since):
    """Expected automated reviewers with nothing on this head yet: no review of it, no comment or edit after `since`, no concluded check."""
    return [b for b in snap["expected"] if snap["activity"].get(b, 0) < since and b not in snap["concluded_apps"]]


def by_kind(snap, kind):
    return [c for c in snap["checks"] if c["kind"] == kind]


def replies_mode(flag, conv, text):
    """('draft' | 'post', why). `flag`: 'hold' or 'post' from this watch's arguments, which win over the file.
    `conv`: the environment file's path, `text`: what it holds (None when it is set but can't be read)."""
    if flag:
        return ("draft", "--hold-replies") if flag == "hold" else ("post", "--post-replies")
    if conv and text is None:  # the line may be in it, and a posted reply can't be taken back
        return "draft", f"the environment file {conv} can't be read, so whether its owner posts their own replies is unknown"
    if conv and re.search(REPLIES_SETTING, text, re.I | re.M):
        return "draft", f'{conv} says "review replies: draft"'
    return "post", ""


def draft_key(item):
    return f"{item['type']}:{item['id']}"


def mark_held(items, drafts):
    """Marks each open item a reply was drafted for: `held` while nothing was said after the draft, `redraft` once the
    thread got a new comment. (The user's own reply takes the item off the list before this is asked.)"""
    for i in items:
        d = drafts.get(draft_key(i))
        if d:
            i["held" if d.get("last") == i["last"] else "redraft"] = d


def approval_wait(snap):
    need, given = snap["required_approvals"], snap["approvals"]
    if snap["draft"] or (snap["review_decision"] != "REVIEW_REQUIRED" and not (snap["merge_state"] == "BLOCKED" and need and given < need)):
        return None
    return {"need": need, "given": given, "who": snap["reviewers"]}


def approval_text(wait):
    count = f"{wait['given']}/{wait['need']}" if wait["need"] else f"{wait['given']}개"
    return f"승인 {count} (승인 대기: {', '.join(wait['who']) or '요청된 리뷰어 없음'})"


def decide(snap, first_seen, now, pushed=0, settle_rules=True, replies="post", post_held=False):
    """What the snapshot means: `next` steps in order, the settle verdict, and whether the head has settled.

    `pushed`: heads of ours that arrived during this watch. `settle_rules`: the --until-settled limits (30 minutes a head, three pushed fixes).
    `replies`: 'draft' when nothing is posted on this PR. `post_held`: the request asked to post what was held."""
    sha = snap["head"][:7]
    if snap["state"] != "OPEN":
        return {"next": [f"done — the PR is {snap['state'].lower()}; print a one-line summary and stop"], "settled": True, "settle": None,
                "waiting": [], "pending": [], "waited": 0}
    since = snap["pushed"] or first_seen
    waited = max(0, now - first_seen)
    failed, pending, unstarted = by_kind(snap, "failed"), by_kind(snap, "pending"), by_kind(snap, "not-started")
    waiting = waiting_bots(snap, since)
    registering = not snap["checks"] and waited < CHECK_GRACE_SECONDS
    conflict = snap["mergeable"] == "CONFLICTING"
    timed_out = settle_rules and waited >= GIVE_UP_SECONDS
    computing = snap["mergeable"] == "UNKNOWN"  # GitHub hasn't worked out mergeability yet: a conflict may be hiding
    settled = not pending and not waiting and not registering and not computing

    nxt, human = [], []
    if conflict:
        nxt.append("conflict — read references/conflicts.md (CI keeps failing on the merge commit while it stands)")
        human.append(f"병합 충돌(base: {snap['base']})")
    open_items = [i for i in snap["items"] if not i.get("held")]
    held = [i for i in snap["items"] if i.get("held")]
    comments_at = len(nxt)
    if open_items:
        how = f"draft each reply, post nothing, push no fix made for one ({HELD_DOC})" if replies == "draft" else "reply once"
        nxt.append(f"comments — {len(open_items)} open; classify each by references/comments.md and {how}")
        human += [f"{i['author']} {i['where']}" for i in open_items]
    postable = [i for i in held if i["held"].get("reply") and not i["held"].get("posted")]
    if postable and post_held:
        nxt.append(f"post — {len(postable)} held draft(s): push their commits, then post each `reply:` above as it is written "
                   "(a JSON string: decode it, change nothing), one reply each (references/comments.md)")
    human += [f"{i['author']} {i['where']} (답글 초안)" for i in held]
    if failed:
        nxt.append("ci — " + ", ".join(c["name"] for c in failed) + "; read the failing log, fix what the diff caused (one commit per fix); "
                   "a check still failing after two fixes: read ../../references/premise.md before stopping, no third fix")
        human += [f"실패한 체크 {c['name']}" for c in failed]
        if replies == "draft" and open_items:  # a CI fix is pushed, a comment's fix is not: the one that can be pushed goes first
            nxt.append(nxt.pop(comments_at))
    if unstarted:
        human += [f"CI 미실행(계정) {c['name']}" for c in unstarted]
    approval = approval_wait(snap)
    if approval:
        human.append(approval_text(approval))
    if settle_rules and pushed >= MAX_PUSHED_HEADS and (conflict or open_items or failed):
        nxt.insert(0, f"limit — {MAX_PUSHED_HEADS} fixes already pushed in this watch: push no more; report what is still open")

    settle = None
    if not settled and not timed_out:
        what = [c["name"] for c in pending] + waiting + (["checks to register"] if registering else []) \
            + (["GitHub's mergeability check"] if computing else [])
        nxt.append("wait — `pr-status wait` again; still running: " + ", ".join(what))
    elif not settled:
        missing = [c["name"] for c in pending] + waiting + (["병합 가능 여부(GitHub 계산 중)"] if computing else [])
        nxt.append(f"give up — {int(waited // 60)} minutes on this head; report what hasn't concluded")
        settle = f"settle: 미확정 @{sha} — 안 옴: {', '.join(missing)}"
    if human:
        settle = f"settle: 사람 필요 @{sha} — {', '.join(human)}"  # wins over 미확정; only if it can't be fixed here
        if settled and not nxt:  # nothing here to fix or wait for: say so, or `wait` would never return
            if unstarted:
                nxt.append("unstarted — these checks never started for account reasons, not because of the diff; nothing to fix "
                           "(with --merge: references/merge.md)")
            if approval:
                nxt.append(f"approval — the merge waits on a person's approval: {approval_text(approval)}; nothing to fix or push here, "
                           "and requesting reviewers is not this run's job (--until-settled: report the settle line; --merge: don't merge)")
            if held:
                ask = sum(1 for i in held if not i["held"].get("reply"))
                nxt.append(f"held — {len(held)} reply draft(s) wait on the user: nothing more to do here until they reply or a new "
                           "comment arrives; don't fix or draft them again"
                           + (f" — except {ask} with no draft yet: with a person here, ask about each (its line above)" if ask else ""))
    elif settled:
        settle = f"settle: 수렴 @{sha}"
        nxt.append("settled — nothing open on this head")
    return {"next": nxt, "settled": settled, "settle": settle, "waiting": waiting, "pending": [c["name"] for c in pending], "waited": waited,
            "post": bool(postable and post_held)}


def merge_gate(snap, verdict, verified_locally=False):
    """(ok, reasons) for `--merge`. The deploy-on-merge question stays with the skill: it needs the workflows read."""
    if snap["state"] != "OPEN":
        return False, [f"the PR is {snap['state'].lower()}"]
    reasons = []
    failed, unstarted = by_kind(snap, "failed"), by_kind(snap, "not-started")
    blocking = failed  # required or not: a red check next to a merge is how 14 PRs went in broken
    if snap["draft"]:
        reasons.append("still a draft")
    if snap["mergeable"] == "CONFLICTING":
        reasons.append("merge conflict")
    if blocking:
        reasons.append("failing: " + ", ".join(c["name"] for c in blocking))
    if not verdict["settled"]:
        still = verdict["pending"] + verdict["waiting"]
        reasons.append("not settled: " + ", ".join(still) if still else "not settled")
    if snap["review_decision"] == "CHANGES_REQUESTED" or any(i["type"] == "changes-requested" for i in snap["items"]):
        reasons.append("a CHANGES_REQUESTED review stands")
    open_items = [i for i in snap["items"] if i["type"] != "changes-requested"]
    if open_items:
        reasons.append(f"{len(open_items)} unanswered review comments")
    approval = approval_wait(snap)
    if approval:
        count = f"{approval['given']} of {approval['need']} approvals" if approval["need"] else f"{approval['given']} approvals so far"
        reasons.append(f"review required ({count}; waiting on: {', '.join(approval['who']) or 'no reviewer requested'})")
    if unstarted and not verified_locally:
        reasons.append("checks never started (account) and no `verified-locally`: " + ", ".join(c["name"] for c in unstarted))
    state = snap["merge_state"]  # UNSTABLE is fine only for checks that never started, which `verified_locally` already vouched for
    if not reasons and not (state in ("CLEAN", "HAS_HOOKS") or (state == "UNSTABLE" and unstarted)):
        reasons.append(f"merge state {state}")
    return not reasons, reasons


def merge_method(allowed, recent_subjects):
    """The methods the repo allows, and among them the one its recent merges used."""
    squash = sum(1 for s in recent_subjects if re.search(r"\(#\d+\)$", s))
    merge = sum(1 for s in recent_subjects if s.startswith("Merge pull request #"))
    order = ["squash", "merge", "rebase"] if squash >= merge else ["merge", "squash", "rebase"]
    flags = {"squash": "squashMergeAllowed", "merge": "mergeCommitAllowed", "rebase": "rebaseMergeAllowed"}
    return next((m for m in order if allowed.get(flags[m], True)), "squash")


def render(snap, verdict, new_links=()):
    kinds = {k: len(by_kind(snap, k)) for k in ("passed", "failed", "pending", "skipped", "not-started")}
    out = [f"pr: #{snap['number']} {snap['state']}{' draft' if snap['draft'] else ''} @{snap['head'][:7]} · merge state {snap['merge_state']}"
           f" · {snap['url']}",
           "checks: " + (", ".join(f"{n} {k}" for k, n in kinds.items() if n) or "none")]
    for c in snap["checks"]:
        if c["kind"] == "failed":
            log = f" · gh run view --job {c['id']} --log-failed" if c["id"] and "/actions/" in c["url"] else f" · {c['url']}"
            out.append(f"  failed: {c['name']}{' (required)' if c['required'] else ''}{log}")
        elif c["kind"] == "not-started":
            out.append(f"  not started (account, not the diff): {c['name']}")
    open_items = [i for i in snap["items"] if not i.get("held")]
    held = [i for i in snap["items"] if i.get("held")]
    if open_items:
        out.append(f"open comments: {len(open_items)}")
        for i in open_items:
            trust = "trusted" if i["trusted"] else "NOT trusted — never auto-apply"
            again = ""
            if i.get("redraft"):
                was = i["redraft"]
                again = (f" · new comment since a draft ({was['verdict']}{' ' + was['commit'] if was.get('commit') else ''}): "
                         "read the thread again, don't redo that fix")
            out.append(f"  [{i['type']} {i['id']}] {i['author']} ({i['assoc'] or ('bot' if i['bot'] else '?')}, {trust}) {i['where']}"
                       f"{' · has a suggestion block' if i['suggestion'] else ''}{again}: {i['quote']}")
    if held:
        out.append(f"held replies: {len(held)} (drafted, not posted; the user's own reply or a new comment takes one off this list)")
        for i in held:
            d = i["held"]
            if d.get("posted"):
                text = "answered on the PR: waits for the reviewer to review again"
            elif not d.get("reply"):
                text = "no draft yet: with a person here, ask them about it (references/comments.md); headless, leave it"
            elif verdict.get("post"):  # the whole text, since it is what gets posted
                text = "reply: " + json.dumps(d["reply"], ensure_ascii=False)
            else:
                text = "draft: " + first_line(d["reply"])
            out.append(f"  [{i['type']} {i['id']}] {i['author']} {i['where']} · {d['verdict']}{commit_note(d)} · {text}")
    if snap["expected"]:
        out.append("automated reviewers: " + ", ".join(f"{b} ({'waiting' if b in verdict['waiting'] else 'done'})" for b in snap["expected"]))
    out += [f"link: {l['url']} (from {l['source']}, built from {snap['head'][:7]})" for l in new_links]
    out += [f"note [{n['id']}] {n['author']} (bot): {n['quote']} · {n['url']}" for n in verdict.get("new_notes", [])]
    if verdict["waited"]:
        out.append(f"waited: {int(verdict['waited'] // 60)}m of {GIVE_UP_SECONDS // 60}m on this head")
    if verdict["settle"]:
        out.append(verdict["settle"])
    out += [f"next: {n}" for n in verdict["next"]]
    return out


def commit_note(draft):
    if not draft.get("commit"):
        return ""
    where = {"rewritten": "rewritten since (a rebase or an amend): find its new sha and record the comment with `drafted` again"}
    state = draft.get("pushed")
    return f" {draft['commit']}" + (f" ({where.get(state, state)})" if state else "")


def draft_table(drafts):
    """The table a person reads: one row per held reply, the reply as it would be posted, and the reason behind a decline."""
    def cell(text):
        return " ".join((text or "").replace("|", "\\|").split()) or "—"

    rows = ["| # | 댓글 | 판단 | 수정 커밋 | 답글 초안 |", "|---|---|---|---|---|"]
    reasons = []
    for n, d in enumerate(drafts, 1):
        where = f"[`{d['where']}`]({d['url']})" if d.get("url") else f"`{d['where']}`"
        pushed = {"pushed": " (푸시됨)", "not pushed": " (푸시 안 함)", "rewritten": " (다시 쓰인 커밋)"}.get(d.get("pushed"), "")
        commit = f"`{d['commit']}`{pushed}" if d.get("commit") else "—"
        reply = (d.get("reply") or "").strip().replace("|", "\\|").replace("\n", "<br>")
        rows.append(f"| {n} | {d['author']} · {where} · {cell(d.get('gist') or d.get('quote'))} | {VERDICTS[d['verdict']]} | {commit} | "
                    f"{reply or '—'} |")
        if d.get("why"):
            reasons.append(f"- #{n} 근거: {cell(d['why'])}")
    return rows + ([""] + reasons if reasons else [])


def parse_drafts(text, items, short_sha=lambda rev: rev):
    """(entries by key, errors) from `drafted`'s stdin. Nothing is recorded unless every line is good."""
    by_id = {}
    for i in items:
        by_id.setdefault(str(i["id"]), []).append(i)
    entries, errors = {}, []
    for n, line in enumerate(filter(None, (l.strip() for l in text.splitlines())), 1):
        try:
            d = json.loads(line)
        except ValueError:
            d = None
        if not isinstance(d, dict):
            errors.append(f"line {n} is not one JSON object")
            continue
        if any(not isinstance(d.get(k) or "", str) for k in ("reply", "why", "gist", "commit", "verdict")):
            errors.append(f"line {n}: reply, why, gist, commit, and verdict are strings (a reply of several lines is one string with \\n)")
            continue
        found = [i for i in by_id.get(str(d.get("id")), []) if d.get("type") in (None, i["type"])]
        verdict = d.get("verdict")
        if not found:
            errors.append(f"line {n}: {d.get('id')} is not an open comment on this PR (open: "
                          f"{', '.join(str(i['id']) for i in items) or 'none'})")
        elif verdict not in VERDICTS:
            errors.append(f"line {n}: verdict is one of {', '.join(VERDICTS)}")
        elif verdict == "fixed" and not d.get("commit"):
            errors.append(f"line {n}: a fixed comment names its commit")
        elif verdict != "undecided" and not (d.get("reply") or "").strip():
            errors.append(f"line {n}: no reply text (only an undecided comment has none yet)")
        elif verdict == "declined" and not (d.get("why") or "").strip():
            errors.append(f"line {n}: a declined comment carries why, with the file:line that shows it")
        else:
            i = found[0]
            commit = short_sha(d["commit"]) if d.get("commit") else None
            if d.get("commit") and not commit:
                errors.append(f"line {n}: no commit {d['commit']} in this repo")
                continue
            entries[draft_key(i)] = {**{k: i[k] for k in ("type", "id", "last", "author", "where", "quote", "url")}, "verdict": verdict,
                                     "commit": commit, "reply": (d.get("reply") or "").strip(), "why": (d.get("why") or "").strip(),
                                     "gist": (d.get("gist") or "").strip()}
    return entries, errors


# --- gh and state ----------------------------------------------------------

def resolve(pr_arg):
    view = json.loads(sh(["gh", "pr", "view", *([pr_arg] if pr_arg else []), "--json", "number,url"]))
    m = re.match(r"https://([^/]+)/([^/]+)/([^/]+)/pull/(\d+)", view["url"])
    return m.group(1), m.group(2), m.group(3), int(m.group(4))


def fetch(owner, repo, number, me, polls=()):
    out = sh(["gh", "api", "graphql", "-f", f"query={QUERY}", "-F", f"owner={owner}", "-F", f"repo={repo}", "-F", f"number={number}"], body_on_error=True)
    try:
        raw = json.loads(out)
    except ValueError:
        raise GhError("graphql: no JSON in gh's output")
    if not ((raw.get("data") or {}).get("repository") or {}).get("pullRequest"):  # a REST-style error body ("Bad credentials", 502) has no data
        errors = raw.get("errors") or [{}]
        raise GhError(raw.get("message") or errors[0].get("message") or "graphql: no pull request in the response")

    def annotations(check_id):
        if check_id not in ANNOTATIONS:  # a concluded run's annotations don't change: ask once, not on every poll
            try:
                ANNOTATIONS[check_id] = [a.get("message", "") for a in json.loads(sh(["gh", "api", f"repos/{owner}/{repo}/check-runs/{check_id}/annotations"]))]
            except (GhError, ValueError):
                return []
        return ANNOTATIONS[check_id]
    return normalize(raw["data"], me, annotations, polls, lambda base: required_approvals(owner, repo, base))


def required_approvals(owner, repo, base):
    """None when neither can be read (protection needs admin)."""
    if (owner, repo, base) not in REQUIRED_APPROVALS:
        counts, ref = [], urllib.parse.quote(base, safe="")
        try:
            counts.append(json.loads(sh(["gh", "api", f"repos/{owner}/{repo}/branches/{ref}/protection/required_pull_request_reviews"]))
                          .get("required_approving_review_count"))
        except (GhError, ValueError, AttributeError):
            pass
        try:
            counts += [(r.get("parameters") or {}).get("required_approving_review_count")
                       for r in json.loads(sh(["gh", "api", f"repos/{owner}/{repo}/rules/branches/{ref}"])) if r.get("type") == "pull_request"]
        except (GhError, ValueError, AttributeError, TypeError):
            pass
        REQUIRED_APPROVALS[(owner, repo, base)] = max([c for c in counts if isinstance(c, int)], default=None)
    return REQUIRED_APPROVALS[(owner, repo, base)]


def state_path(number):
    git_dir = sh(["git", "rev-parse", "--absolute-git-dir"], check=False)
    base = Path(git_dir) / "gbase" if git_dir else Path.home() / ".cache" / "gbase"
    base.mkdir(parents=True, exist_ok=True)
    return base / f"pr-status-{number}.json"


def replies_file(host, owner, repo, number):
    """Outside every repo and git dir: a worktree goes away with its git dir, and the drafts are the user's to read.
    One folder per host, owner, and repo: joined into one name, `acme/web-app` and `acme-web/app` would share a file."""
    home = Path(os.environ.get("GBASE_HOME") or "~/.gbase").expanduser().resolve()  # absolute: the runner reads the path from the report
    return home.joinpath("replies", *(re.sub(r"[^A-Za-z0-9._-]+", "-", part) for part in (host, owner, repo)), f"pr-{number}.json")


@contextlib.contextmanager
def locked(path):
    """One process at a time through a file's read-modify-write: a watch prunes the drafts every poll while `drafted` adds to
    them, and writes its state while another call records a request in it."""
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path.with_suffix(".lock"), "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def load_drafts(path):
    try:
        drafts = json.loads(path.read_text(encoding="utf-8"))
        return drafts if isinstance(drafts, dict) else {}
    except (OSError, ValueError):
        return {}


def save_drafts(path, drafts, title):
    """The record and, beside it, the table as a file a person can open. `pushed` is this clone's view, so it isn't recorded."""
    table = path.with_suffix(".md")
    if not drafts:
        for f in (path, table):
            f.unlink(missing_ok=True)
        return None
    record = json.dumps({k: {f: v for f, v in d.items() if f != "pushed"} for k, d in drafts.items()}, ensure_ascii=False)
    for f, text in ((path, record), (table, "\n".join([f"# {title}", "", *draft_table(drafts.values())]) + "\n")):
        tmp = f.with_name(f.name + ".tmp")  # a reader never sees half a file
        tmp.write_text(text, encoding="utf-8")
        os.replace(tmp, f)
    return table


def same_text(text):
    return " ".join(text.split())


def still_held(drafts, snap):
    """The drafts whose comment still waits: not answered, resolved, or superseded."""
    open_keys = {draft_key(i) for i in snap["items"]}
    return {k: d for k, d in drafts.items() if k in open_keys}


def sync_drafts(path, snap, title):
    """Drops the drafts that no longer wait (all of them once the PR is merged or closed), marks the rest on the snapshot,
    and says where each fix commit is."""
    if not path.exists():
        return {}
    with locked(path):
        kept = still_held(load_drafts(path), snap) if snap["state"] == "OPEN" else {}
        for d in kept.values():
            d["pushed"] = commit_state(d.get("commit"), snap["head"], snap["branch"])
            # a `changes-requested` review stays listed until its reviewer reviews again. Once its summary is on the PR as our
            # comment it is answered; the record stays, or the review would be open, drafted, and fixed again
            if d["type"] == "changes-requested" and d.get("reply") and same_text(d["reply"]) in map(same_text, snap.get("my_comments", [])):
                d["posted"] = True
        save_drafts(path, kept, title)  # every time: the table file says where each commit is now
    mark_held(snap["items"], kept)
    return kept


def commit_state(commit, head, branch):
    """'pushed' when the PR's head holds the commit, 'not pushed' when only the local branch does, 'rewritten' when neither
    does any more (a rebase or an amend gave the fix a new sha), None when this clone can't tell."""
    def within(ref):
        try:
            return subprocess.run(["git", "merge-base", "--is-ancestor", commit, ref], capture_output=True).returncode
        except OSError:
            return None

    if not commit:
        return None
    on_head = within(head)
    if on_head == 0:
        return "pushed"
    return {0: "not pushed", 1: "rewritten"}.get(within(f"refs/heads/{branch}")) if on_head == 1 else None


def environment():
    """(the environment file's path, its text; None when it is set but can't be read). ('', '') when none is set."""
    conv = sh(["git", "config", "--get", "--type=path", "gbase.conventions"], check=False)  # --type=path expands a leading ~
    if not conv:
        return "", ""
    try:
        return conv, Path(conv).expanduser().read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return conv, None


def cmd_drafted(args):
    pr_arg = take(args, "--pr")
    try:
        host, owner, repo, number = resolve(pr_arg)
        me = sh(["gh", "api", "user", "-q", ".login"])
        # the polls of the watch: the same comments are open here as in the snapshot that listed them
        snap = fetch(owner, repo, number, me, load_state(state_path(number)).get("polls", []))
    except GhError as e:
        print(f"error: {e}")
        return 1
    path, title = replies_file(host, owner, repo, number), f"PR #{number} 답글 초안 ({owner}/{repo})"
    text = "" if sys.stdin.isatty() else sys.stdin.read()
    short_sha = lambda rev: sh(["git", "rev-parse", "--short", "--verify", "--quiet", f"{rev}^{{commit}}"], check=False)
    entries, errors = parse_drafts(text, snap["items"], short_sha)
    if errors:
        print("\n".join([f"error: {e}" for e in errors] + ["next: nothing was recorded — fix the lines and run `pr-status drafted` again"]))
        return 1
    with locked(path):
        drafts = {**still_held(load_drafts(path), snap), **entries}
        for d in drafts.values():
            d["pushed"] = commit_state(d.get("commit"), snap["head"], snap["branch"])
        table = save_drafts(path, drafts, title)
    if not drafts:
        print("drafted: none — no reply is held as a draft on this PR")
        return 0
    print("\n".join([f"drafted: {len(entries)} recorded, {len(drafts)} held — pr-status lists them under `held replies`, not as open",
                     *draft_table(drafts.values()),
                     *(f"reply [{d['type']} {d['id']}]: {json.dumps(d['reply'], ensure_ascii=False)}" for d in drafts.values() if d.get("reply")),
                     f"reply drafts: {table}",
                     f"next: show the table as printed and ask what to do with it ({HELD_DOC}); headless: the table and the "
                     "`reply drafts:` line go in the report. A reply that is posted is its `reply [...]` line above (a JSON string: decode it), "
                     "not its table cell, which is escaped for the table. Under --until-settled, `pr-status wait` once more prints the `settle:` line"]))
    return 0


def write_state(path, state):
    tmp = path.with_name(path.name + ".tmp")  # a reader never sees half a file
    tmp.write_text(json.dumps(state))
    os.replace(tmp, path)


def save_state(path, state):
    """With the reply request as the file has it now: another call of this watch may have made one while this one was polling,
    and a `watch` must not write its older copy over it."""
    with locked(path):
        asked = load_state(path).get("replies")
        state.pop("replies", None)
        if asked:
            state["replies"] = asked
        write_state(path, state)


def load_state(path, fresh=False):
    if not fresh and path.exists():
        try:
            return json.loads(path.read_text())
        except ValueError:
            pass
    return {"heads": {}, "links": []}


def observe(state, snap, now):
    """Record this poll in the state; returns (first-seen time of the head, links not shown before, bot notes not shown before)."""
    if snap["head"] not in state["heads"] and state["heads"] and snap.get("head_is_mine"):
        state["pushed"] = state.get("pushed", 0) + 1  # a head of ours that arrived during the watch: a fix we pushed
    first_seen = state["heads"].setdefault(snap["head"], now)
    new_links = [l for l in snap["links"] if l["url"] not in state["links"]]
    state["links"] += [l["url"] for l in new_links]
    keys = {f"{n['id']}@{n['at']}": n for n in snap.get("notes", [])}  # an edited comment is new again
    shown = state.setdefault("notes", [])
    new_notes = [n for k, n in keys.items() if k not in shown]
    shown += [k for k in keys if k not in shown]
    state["polls"] = (state.get("polls", []) + [now])[-200:]
    return first_seen, new_links, new_notes


def merge_lines(snap, verdict, owner, repo, verified_locally):
    ok, reasons = merge_gate(snap, verdict, verified_locally)
    if not ok:
        return ["merge: not now — " + "; ".join(reasons)]
    out = []
    try:
        allowed = json.loads(sh(["gh", "repo", "view", f"{owner}/{repo}", "--json", "squashMergeAllowed,mergeCommitAllowed,rebaseMergeAllowed"]))
        subjects = sh(["git", "log", f"origin/{snap['base']}", "-15", "--format=%s"], check=False).splitlines()
        method = merge_method(allowed, subjects)
        stacked = json.loads(sh(["gh", "pr", "list", "--base", snap["branch"], "--state", "open", "--json", "number"]))
    except (GhError, ValueError) as e:
        return [f"merge: gate passed, but the repo's merge settings couldn't be read — {e}"]
    for s in stacked:
        out.append(f"merge: retarget stacked PR first — gh pr edit {s['number']} --base {snap['base']} (don't rebase or push its branch)")
    workflows = push_workflows(Path(sh(["git", "rev-parse", "--show-toplevel"], check=False) or ".") / ".github" / "workflows")
    if workflows:
        out.append(f"merge: workflows that run on push — {', '.join(workflows)}. If one deploys on {snap['base']} and this PR's paths aren't "
                   "excluded, the merge is a deploy: don't merge, a person decides (references/merge.md)")
    out.append(f"merge: gate passed — gh pr merge {snap['number']} --{method} --delete-branch (drop --delete-branch if the repo keeps merged branches)")
    return out


def push_workflows(directory):
    """Workflow files that run on push, in any of the three ways YAML lets `on:` say it."""
    return sorted(p.name for p in directory.glob("*.y*ml") if PUSH_TRIGGER.search(p.read_text(errors="ignore")))


def patch_id(fork, rev, path=None):
    """`git patch-id` of what `rev` changes since `fork`, where it left the base: the same after a rebase that replayed the change untouched."""
    # bytes, not text: a diff may hold bytes that aren't UTF-8; the path is taken as it is, not as a pattern
    diff = subprocess.run(["git", "--literal-pathspecs", "diff", "--binary", fork, rev, *(["--", path] if path else [])], capture_output=True)
    if diff.returncode:
        raise GhError(diff.stderr.decode(errors="replace").strip() or "git diff failed")
    out = subprocess.run(["git", "patch-id", "--stable"], input=diff.stdout, capture_output=True).stdout.split()
    # patch-id drops all whitespace and skips binary hunks, so a re-indented block (Python, YAML) or a replaced image would read as
    # the same change: add the patch's own lines, without the positions and blob ids a rebase moves
    body = [re.sub(rb"^@@ .*", b"@@", l) for l in diff.stdout.split(b"\n") if not l.startswith((b"index ", b"diff --git "))]
    return (out[0].decode() if out else "") + ":" + hashlib.sha1(b"\n".join(body)).hexdigest()[:12]


def changed_files(fork, rev):
    return set(filter(None, sh(["git", "diff", "--name-only", "-z", fork, rev]).split("\0")))  # -z: git quotes odd names otherwise


def patch_lines(base, was, head="HEAD"):
    """Whether the earlier verification still describes the branch. One full verification, one verifier for a changed patch, none for wording."""
    short = lambda rev: sh(["git", "rev-parse", "--short", rev])
    was_fork, head_fork = (sh(["git", "merge-base", base, rev]) for rev in (was, head))
    if patch_id(was_fork, was) == patch_id(head_fork, head):
        return [f"patch: same — {short(was)} and {short(head)} carry the same change onto {base}",
                "next: nothing to re-verify — the earlier checks describe this head; CI runs on it after the push"]
    files = sorted(f for f in changed_files(was_fork, was) | changed_files(head_fork, head)
                   if patch_id(was_fork, was, f) != patch_id(head_fork, head, f))
    code = [f for f in files if not any(re.fullmatch(g, f.rsplit("/", 1)[-1], re.I) for g in WORDING_FILES)]
    lines = [f"patch: changed — {short(was)} → {short(head)}: {', '.join(files) or 'no single file found'}"]
    if not files:  # the whole patch differs but no file's does: not evidence that only wording changed
        code = ["the whole change"]
    if not code:
        return lines + ["next: nothing to re-verify — only wording changed"]
    return lines + [f"next: one verifier — rerun the checks and the behavior check that cover {', '.join(code)} (references/conflicts.md); "
                    "not a second full review"]


def cmd_patch(args):
    base, was = take(args, "--base"), take(args, "--was")
    try:
        if not base:
            try:
                name = sh(["gh", "pr", "view", "--json", "baseRefName", "-q", ".baseRefName"], check=False)
            except GhError:  # no gh here: origin/HEAD still names a base
                name = ""
            base = f"origin/{name}" if name else sh(["git", "symbolic-ref", "--short", "refs/remotes/origin/HEAD"])
        was = was or sh(["git", "rev-parse", "--abbrev-ref", "@{upstream}"])
        print("\n".join(patch_lines(base, was)))
    except GhError as e:
        print(f"error: {e}\nnext: name them — pr-status patch --base <ref the branch was rebased onto> --was <the head that was verified>")
        return 1
    return 0


def take(args, flag, default=None, cast=str):
    if flag not in args:
        return default
    i = args.index(flag)
    try:
        value = cast(args[i + 1])
    except (IndexError, ValueError):
        raise SystemExit(f"error: {flag} needs a value\n\n{__doc__.strip()}")
    del args[i:i + 2]
    return value


def main(argv):
    args = list(argv)
    mode = args.pop(0) if args and args[0] in ("wait", "watch") else "snapshot"
    if "-h" in args or "--help" in args:
        print(__doc__.strip())
        return 0
    if args and args[0] == "patch":
        return cmd_patch(args[1:])
    if args and args[0] == "drafted":
        return cmd_drafted(args[1:])
    pr_arg = take(args, "--pr")
    timeout = take(args, "--timeout", 270, int)
    interval = take(args, "--interval", 30, int)
    want_merge, verified, handled = "--merge" in args, "--verified-locally" in args, "--handled" in args
    settle_rules = mode == "wait" or "--until-settled" in args
    try:
        host, owner, repo, number = resolve(pr_arg)
        me = sh(["gh", "api", "user", "-q", ".login"])
    except GhError as e:
        print(f"error: {e}\nnext: no PR for this branch → /gbase:branch-pr; no gh auth → the user runs `gh auth login`")
        return 1
    path = state_path(number)
    state = load_state(path, fresh="--start" in args)
    asked = "hold" if "--hold-replies" in args else "post" if "--post-replies" in args else None
    if asked:
        state["replies"] = asked  # the request holds for the watch, not only for the call that carried it
    if asked or "--start" in args:
        with locked(path):  # before the first poll: every process of the watch reads the request from the file
            write_state(path, state)
    flag, replies, why = None, "post", ""
    drafts_path, drafts_title = replies_file(host, owner, repo, number), f"PR #{number} 답글 초안 ({owner}/{repo})"

    def poll():
        nonlocal flag, replies, why
        # read again on every poll: a `watch` that started earlier must follow a request made since, not write its own copy over it
        flag = load_state(path).get("replies")
        state.pop("replies", None)
        if flag:
            state["replies"] = flag
        replies, why = replies_mode(flag, *environment())
        polls = state.get("polls", [])
        snap = fetch(owner, repo, number, me, polls)
        for _ in range(3):  # mergeability is computed lazily: the first query after a push often says UNKNOWN
            if snap["state"] != "OPEN" or snap["mergeable"] != "UNKNOWN":
                break
            time.sleep(2)
            snap = fetch(owner, repo, number, me, polls)
        now = time.time()
        first_seen, new_links, new_notes = observe(state, snap, now)
        sync_drafts(drafts_path, snap, drafts_title)
        verdict = decide(snap, first_seen, now, state.get("pushed", 0), settle_rules, replies, post_held=flag == "post")
        if new_notes and snap["state"] == "OPEN":
            verdict["new_notes"] = new_notes
            verdict["next"].insert(0, f"notes — {len(new_notes)} new bot comment(s): open each one; a finding in it is handled like a review comment "
                                      "(references/comments.md), a preview link or a summary needs nothing")
        save_state(path, state)
        return snap, verdict, new_links

    def full(snap, verdict, new_links):
        lines = render(snap, verdict, new_links)
        if replies == "draft":
            lines.insert(1, f"replies: draft — {why}: post nothing on this PR and push no fix made for a comment; read {HELD_DOC} "
                            "before handling a comment")
        elif flag == "post":
            lines.insert(1, "replies: post — --post-replies, whatever the environment file says")
        if any(i.get("held") for i in snap["items"]):
            lines.insert(len(lines) - len(verdict["next"]), f"reply drafts: {drafts_path.with_suffix('.md')}")
        if want_merge and snap["state"] == "OPEN":
            lines += merge_lines(snap, verdict, owner, repo, verified)
        return lines

    if mode == "snapshot":
        try:
            print("\n".join(full(*poll())))
        except GhError as e:
            print(f"error: {e}")
            return 1
        return 0

    deadline, last, baseline = time.time() + timeout, None, None
    while True:
        try:
            snap, verdict, new_links = poll()
        except GhError as e:
            print(f"{time.strftime('%H:%M:%S')} gh error: {e}", flush=True)
            snap = None
        if snap:
            actionable = [n for n in verdict["next"] if not n.startswith("wait")]
            if handled:  # fixed locally, so still red on the pushed head: only something new, or everything concluding, is news
                if baseline is None:
                    baseline = set(actionable)
                actionable = [n for n in actionable if n not in baseline] or (verdict["next"] if verdict["settled"] else [])
            if mode == "wait":
                if actionable:
                    print("\n".join(full(snap, verdict, new_links)))
                    return 0
                kinds = {k: len(by_kind(snap, k)) for k in ("passed", "pending")}
                for l in new_links:  # shown once, so never dropped on a quiet poll
                    print(f"link: {l['url']} (from {l['source']}, built from {snap['head'][:7]})")
                print(f"{time.strftime('%H:%M:%S')} @{snap['head'][:7]} checks {kinds['passed']} passed, {kinds['pending']} pending; "
                      f"reviewers waiting: {', '.join(verdict['waiting']) or 'none'}; {int(verdict['waited'] // 60)}m of "
                      f"{GIVE_UP_SECONDS // 60}m", flush=True)
            else:
                lines = [l for l in full(snap, verdict, new_links) if not l.startswith("waited:")]
                if lines != last:
                    changed = [l for l in lines if last is None or l not in last]
                    if changed:  # a line that only went away is not an event
                        print(" ‖ ".join(l.strip() for l in changed), flush=True)
                    last = lines
                if snap["state"] != "OPEN":
                    return 0
        if mode == "wait" and time.time() + interval > deadline:
            print("next: wait — nothing changed yet; run `pr-status wait` again")
            return 0
        time.sleep(interval)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
